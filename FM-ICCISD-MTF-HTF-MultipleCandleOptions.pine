bool is_new_15m = is_new_htf_tf

// ==========================================================
// CSMT EXACT INTRARANGE SWING ANCHOR TRACKER
// C2 anchor = exact chart-bar time of the C2 HTF extreme.
// C3 anchor = exact chart-bar time of the running C3 HTF extreme.
// This updates tick-by-tick on the live chart. No C3 close is required.
// ==========================================================
var float csmt_run_h = na
var float csmt_run_l = na
var int   csmt_run_h_time = na
var int   csmt_run_l_time = na
var float csmt_prev_h = na
var float csmt_prev_l = na
var int   csmt_prev_h_time = na
var int   csmt_prev_l_time = na

if na(csmt_run_h)
    csmt_run_h := high
    csmt_run_l := low
    csmt_run_h_time := time
    csmt_run_l_time := time
else if is_new_15m
    csmt_prev_h := csmt_run_h
    csmt_prev_l := csmt_run_l
    csmt_prev_h_time := csmt_run_h_time
    csmt_prev_l_time := csmt_run_l_time
    csmt_run_h := high
    csmt_run_l := low
    csmt_run_h_time := time
    csmt_run_l_time := time
else
    if high > csmt_run_h
        csmt_run_h := high
        csmt_run_h_time := time
    if low < csmt_run_l
        csmt_run_l := low
        csmt_run_l_time := time

// ==========================================================
// C.SMT — C2 -> C3 CORRELATED CONTINUATION
// FIXED: historical CSMT persistence + correct correlated C3 live values
// ==========================================================
var line[] csmt_history_lines = array.new_line()
var label[] csmt_history_labels = array.new_label()
var line csmt_live_line = na
var label csmt_live_label = na

csmt_trim_history() =>
    int max_csmt = math.max(1, math.max(bull_history, bear_history))
    while array.size(csmt_history_lines) > max_csmt
        line old_l = array.shift(csmt_history_lines)
        label old_lb = array.shift(csmt_history_labels)
        line.delete(old_l)
        if not na(old_lb)
            label.delete(old_lb)

csmt_get_name(bool s1, bool s2) =>
    s1 and s2 ? smt_sym1_ticker + "/" + smt_sym2_ticker : s1 ? smt_sym1_ticker : s2 ? smt_sym2_ticker : ""

// ----------------------------------------------------------
// Source HTF candles:
// C1 = [2], C2 = [1], C3 = [0] (C3 is live).
// Correlated C3 MUST use the correlated symbol's own live
// high/low. The old version accidentally compared the source
// C3 low/high against the correlated C2 levels.
// ----------------------------------------------------------
[cs1_h1, cs1_l1, cs1_o1, cs1_c1] = request.security(smt_sym1_resolved, active_htf_tf, [high[1], low[1], open[1], close[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[cs1_h2, cs1_l2, cs1_o2, cs1_c2] = request.security(smt_sym1_resolved, active_htf_tf, [high[2], low[2], open[2], close[2]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[cs2_h1, cs2_l1, cs2_o1, cs2_c1] = request.security(smt_sym2_resolved, active_htf_tf, [high[1], low[1], open[1], close[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[cs2_h2, cs2_l2, cs2_o2, cs2_c2] = request.security(smt_sym2_resolved, active_htf_tf, [high[2], low[2], open[2], close[2]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[csmt_c3_h, csmt_c3_l, csmt_c3_o, csmt_c3_c] = request.security(syminfo.tickerid, active_htf_tf, [high, low, open, close], lookahead=barmerge.lookahead_on)
[csmt_c2_h, csmt_c2_l, csmt_c2_o, csmt_c2_c] = request.security(syminfo.tickerid, active_htf_tf, [high[1], low[1], open[1], close[1]], lookahead=barmerge.lookahead_on)
[csmt_c1_h, csmt_c1_l, csmt_c1_o, csmt_c1_c] = request.security(syminfo.tickerid, active_htf_tf, [high[2], low[2], open[2], close[2]], lookahead=barmerge.lookahead_on)

int csmt_c3_time = nz(time(active_htf_tf), time)
int csmt_c2_time = request.security(syminfo.tickerid, active_htf_tf, time[1], lookahead=barmerge.lookahead_on)
int csmt_c1_time = request.security(syminfo.tickerid, active_htf_tf, time[2], lookahead=barmerge.lookahead_on)

// Correlated symbol's LIVE C3 values.
[cs1_live_h, cs1_live_l, cs1_live_o, cs1_live_c] = request.security(smt_sym1_resolved, active_htf_tf, [high, low, open, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[cs2_live_h, cs2_live_l, cs2_live_o, cs2_live_c] = request.security(smt_sym2_resolved, active_htf_tf, [high, low, open, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
// PSP helper: compare closure direction after inverse-correlation normalization.
// Dojis on either side do not qualify.
psp_dir_disagrees(float local_o, float local_c, float corr_o, float corr_c, bool inverse) =>
    int local_dir = local_c > local_o ? 1 : local_c < local_o ? -1 : 0
    int corr_raw_dir = corr_c > corr_o ? 1 : corr_c < corr_o ? -1 : 0
    int corr_dir = inverse ? -corr_raw_dir : corr_raw_dir
    local_dir != 0 and corr_dir != 0 and local_dir != corr_dir
psp_source_name(bool source1, bool source2) =>
    string result = ""
    if source1 and source2
        result := smt_sym1_ticker + "/" + smt_sym2_ticker
    else if source1
        result := smt_sym1_ticker
    else if source2
        result := smt_sym2_ticker
    result

// ----------------------------------------------------------
// CSMT STRICT C2 -> C3 DIVERGENCE
// Bullish CSMT:
//   Chart C3 must NOT take chart C2 low, while a correlated
//   asset C3 DOES take its own C2 low.
// Bearish CSMT:
//   Chart C3 must NOT take chart C2 high, while a correlated
//   asset C3 DOES take its own C2 high.
// No C1 sweep/reclaim condition is used here.
// Equality is treated as "not taken". A take requires < or >.
// ----------------------------------------------------------
bool csmt_local_data = not na(csmt_c3_h) and not na(csmt_c3_l) and not na(csmt_c2_h) and not na(csmt_c2_l)

// The chart must HOLD its C2 extreme during C3.
bool csmt_local_bull_hold = csmt_local_data and csmt_c3_l >= csmt_c2_l
bool csmt_local_bear_hold = csmt_local_data and csmt_c3_h <= csmt_c2_h

// Correlated asset 1: compare its LIVE C3 against its own C2 [1].
bool csmt_corr1_data = not na(cs1_live_h) and not na(cs1_live_l) and not na(cs1_h1) and not na(cs1_l1)
bool csmt_corr1_takes_low  = csmt_corr1_data and cs1_live_l < cs1_l1
bool csmt_corr1_takes_high = csmt_corr1_data and cs1_live_h > cs1_h1

// Correlated asset 2: same strict C2 -> C3 test.
bool csmt_corr2_data = smt_second_on and not na(cs2_live_h) and not na(cs2_live_l) and not na(cs2_h1) and not na(cs2_l1)
bool csmt_corr2_takes_low  = csmt_corr2_data and cs2_live_l < cs2_l1
bool csmt_corr2_takes_high = csmt_corr2_data and cs2_live_h > cs2_h1

// For an inverse correlation, the corresponding opposite extreme is used.
bool csmt_corr1_bull_match = smt_sym1_inverse ? csmt_corr1_takes_high : csmt_corr1_takes_low
bool csmt_corr1_bear_match = smt_sym1_inverse ? csmt_corr1_takes_low  : csmt_corr1_takes_high
bool csmt_corr2_bull_match = smt_second_on and (smt_sym2_inverse ? csmt_corr2_takes_high : csmt_corr2_takes_low)
bool csmt_corr2_bear_match = smt_second_on and (smt_sym2_inverse ? csmt_corr2_takes_low  : csmt_corr2_takes_high)

// A valid CSMT requires one side to take and the chart side to hold.
bool csmt_bull_s1 = csmt_local_bull_hold and csmt_corr1_bull_match
bool csmt_bear_s1 = csmt_local_bear_hold and csmt_corr1_bear_match
bool csmt_bull_s2 = csmt_local_bull_hold and csmt_corr2_bull_match
bool csmt_bear_s2 = csmt_local_bear_hold and csmt_corr2_bear_match

bool csmt_bull = use_smt and allow_bull and (csmt_bull_s1 or csmt_bull_s2)
bool csmt_bear = use_smt and allow_bear and (csmt_bear_s1 or csmt_bear_s2)

// ----------------------------------------------------------
// Helper: write the CSMT state into the HTF floating candle mark.
// This is also what makes historical CSMT redraw after reload.
// ----------------------------------------------------------
csmt_store_mark(int mark_time, bool is_bear, string name, float y1, float y2, int t1, int t2) =>
    int idx = ensure_htf_mark(mark_time)
    HTFMark mk = array.get(htf_marks, idx)
    mk.ssmt := true
    mk.ssmt_bear := is_bear
    mk.ssmt_name := name
    mk.ssmt_y1 := y1
    mk.ssmt_y2 := y2
    mk.ssmt_t1 := t1
    mk.ssmt_t2 := t2
    array.set(htf_marks, idx, mk)

clear_live_ssmt_mark(int mark_time) =>
    int idx = get_htf_mark_index(mark_time)
    if idx >= 0
        HTFMark mk = array.get(htf_marks, idx)
        mk.ssmt := false
        mk.ssmt_bear := false
        mk.ssmt_name := ""
        mk.ssmt_y1 := na
        mk.ssmt_y2 := na
        mk.ssmt_t1 := na
        mk.ssmt_t2 := na
        array.set(htf_marks, idx, mk)

// ----------------------------------------------------------
// FIRST: finalize the previous LIVE CSMT when a new HTF candle
// starts. Never delete a confirmed CSMT here.
// ----------------------------------------------------------
if is_new_15m
    if not na(csmt_live_line)
        array.push(csmt_history_lines, csmt_live_line)
        array.push(csmt_history_labels, csmt_live_label)
        csmt_live_line := na
        csmt_live_label := na
        csmt_trim_history()


// ----------------------------------------------------------
// LIVE CSMT WITH EXACT SWING-TO-SWING ANCHORS
// Bullish: exact swing low inside C2 -> running swing low in C3.
// Bearish: exact swing high inside C2 -> running swing high in C3.
// xloc.bar_time keeps both ends on the actual lower-timeframe bars.
// ----------------------------------------------------------
bool csmt_exact_anchor_ready = not na(csmt_prev_h_time) and not na(csmt_prev_l_time) and not na(csmt_run_h_time) and not na(csmt_run_l_time)

if csmt_bear and csmt_exact_anchor_ready
    string csm_name = csmt_get_name(csmt_bear_s1, csmt_bear_s2)
    int bear_x1 = csmt_prev_h_time
    float bear_y1 = csmt_prev_h
    int bear_x2 = csmt_run_h_time
    float bear_y2 = csmt_run_h
    if na(csmt_live_line)
        csmt_live_line := line.new(x1=bear_x1, y1=bear_y1, x2=bear_x2, y2=bear_y2, xloc=xloc.bar_time, color=col_smt_bear, width=smt_line_width, style=get_line_style(smt_line_style))
        csmt_live_label := label.new(x=get_smt_lbl_x(bear_x1, bear_x2, smt_text_align), y=math.avg(bear_y1, bear_y2), xloc=xloc.bar_time, text=csm_name, style=label.style_none, textcolor=smt_text_color, size=get_text_size(smt_text_size), textalign=text.align_center)
    else
        line.set_xy1(csmt_live_line, bear_x1, bear_y1)
        line.set_xy2(csmt_live_line, bear_x2, bear_y2)
        label.set_xy(csmt_live_label, get_smt_lbl_x(bear_x1, bear_x2, smt_text_align), math.avg(bear_y1, bear_y2))
        label.set_text(csmt_live_label, csm_name)
    // Floating HTF panel still maps by HTF candle start times.
    csmt_store_mark(csmt_c3_time, true, csm_name, bear_y1, bear_y2, csmt_c2_time, csmt_c3_time)
else if csmt_bull and csmt_exact_anchor_ready
    string csm_name = csmt_get_name(csmt_bull_s1, csmt_bull_s2)
    int bull_x1 = csmt_prev_l_time
    float bull_y1 = csmt_prev_l
    int bull_x2 = csmt_run_l_time
    float bull_y2 = csmt_run_l
    if na(csmt_live_line)
        csmt_live_line := line.new(x1=bull_x1, y1=bull_y1, x2=bull_x2, y2=bull_y2, xloc=xloc.bar_time, color=col_smt_bull, width=smt_line_width, style=get_line_style(smt_line_style))
        csmt_live_label := label.new(x=get_smt_lbl_x(bull_x1, bull_x2, smt_text_align), y=math.avg(bull_y1, bull_y2), xloc=xloc.bar_time, text=csm_name, style=label.style_none, textcolor=smt_text_color, size=get_text_size(smt_text_size), textalign=text.align_center)
    else
        line.set_xy1(csmt_live_line, bull_x1, bull_y1)
        line.set_xy2(csmt_live_line, bull_x2, bull_y2)
        label.set_xy(csmt_live_label, get_smt_lbl_x(bull_x1, bull_x2, smt_text_align), math.avg(bull_y1, bull_y2))
        label.set_text(csmt_live_label, csm_name)
    // Floating HTF panel still maps by HTF candle start times.
    csmt_store_mark(csmt_c3_time, false, csm_name, bull_y1, bull_y2, csmt_c2_time, csmt_c3_time)
else
    // Remove only the current unconfirmed live line if the live CSMT
    // condition disappears before the C3 candle has completed.
    if not na(csmt_live_line)
        line.delete(csmt_live_line)
        if not na(csmt_live_label)
            label.delete(csmt_live_label)
        csmt_live_line := na
        csmt_live_label := na
    if not is_new_15m and not na(csmt_c3_time)
        clear_live_ssmt_mark(csmt_c3_time)

if is_new_15m
    c15_start_time := nz(time(active_htf_tf), time)

    active_bear_dist_b := na
    active_bear_dist_lbl := na
    active_bear_dist_eq_l := na 
    active_bear_cont_b := na
    active_bear_cont_lbl := na
    active_bear_cont_eq_l := na
    active_bear_c4_open_l := na
    active_bear_c4_fill_b := na
    active_bear_c3_time := na
    active_bear_c4_time := na
    
    active_bull_dist_b := na
    active_bull_dist_lbl := na
    active_bull_dist_eq_l := na 
    active_bull_cont_b := na
    active_bull_cont_lbl := na
    active_bull_cont_eq_l := na
    active_bull_c4_open_l := na
    active_bull_c4_fill_b := na
    active_bull_c3_time := na
    active_bull_c4_time := na
    
    smt_tracker_curr.prev_h := smt_tracker_curr.h
    smt_tracker_curr.prev_l := smt_tracker_curr.l
    smt_tracker_curr.prev_h_idx := smt_tracker_curr.h_idx
    smt_tracker_curr.prev_l_idx := smt_tracker_curr.l_idx
    smt_tracker_curr.prev_h_t := smt_tracker_curr.h_t
    smt_tracker_curr.prev_l_t := smt_tracker_curr.l_t
    smt_tracker_curr.h := high
    smt_tracker_curr.l := low
    smt_tracker_curr.h_idx := bar_index
    smt_tracker_curr.l_idx := bar_index
    smt_tracker_curr.h_t := c15_start_time
    smt_tracker_curr.l_t := c15_start_time

    smt_tracker1.prev_h := smt_tracker1.h
    smt_tracker1.prev_l := smt_tracker1.l
    smt_tracker1.prev_h_idx := smt_tracker1.h_idx
    smt_tracker1.prev_l_idx := smt_tracker1.l_idx
    smt_tracker1.prev_h_t := smt_tracker1.h_t
    smt_tracker1.prev_l_t := smt_tracker1.l_t
    smt_tracker1.h := smt_sym1_h
    smt_tracker1.l := smt_sym1_l
    smt_tracker1.h_idx := bar_index
    smt_tracker1.l_idx := bar_index
    smt_tracker1.h_t := c15_start_time
    smt_tracker1.l_t := c15_start_time

    smt_tracker2.prev_h := smt_tracker2.h
    smt_tracker2.prev_l := smt_tracker2.l
    smt_tracker2.prev_h_idx := smt_tracker2.h_idx
    smt_tracker2.prev_l_idx := smt_tracker2.l_idx
    smt_tracker2.prev_h_t := smt_tracker2.h_t
    smt_tracker2.prev_l_t := smt_tracker2.l_t
    smt_tracker2.h := smt_sym2_h
    smt_tracker2.l := smt_sym2_l
    smt_tracker2.h_idx := bar_index
    smt_tracker2.l_idx := bar_index
    smt_tracker2.h_t := c15_start_time
    smt_tracker2.l_t := c15_start_time

    bool will_draw_bear_c3 = allow_bear and use_frac and p15_h_swept and close[1] <= p15_h
    bool will_draw_bull_c3 = allow_bull and use_frac and p15_l_swept and close[1] >= p15_l

    if allow_bear and pending_bear_c4
        if not will_draw_bear_c3
            float c3_equilibrium = math.avg(c15_h, c15_l)
            if bear_c3_mid >= open
                if use_cont
                    active_bear_c4_invalid_eq := c3_equilibrium
                    box c4_b = na
                    float bear_c4_text_pad = math.max((c15_h - c15_l) * 0.03, syminfo.mintick * 5)
                    label c4_lbl = label.new(x=bar_index, y=c15_h + bear_c4_text_pad, text="C4", style=label.style_none, textcolor=manip_txt_col, size=chart_text_size, textalign=text.align_left)
                    line c4_eq_l = line.new(x1=bar_index, y1=c3_equilibrium, x2=bar_index + 1, y2=c3_equilibrium, color=col_c4_eq_line, style=c4_eq_style, width=c4_eq_width)
                    if show_bear_c4_quartiles
                        float bear_c4_open = open
                        line bear_c4_open_l = line.new(x1=bar_index, y1=bear_c4_open, x2=bar_index + 1, y2=bear_c4_open, color=col_bear_c4_quartile, style=bear_c4_quartile_style, width=bear_c4_quartile_width)
                        active_bear_c4_open_l := bear_c4_open_l
                        array.push(quartile_history_lines, bear_c4_open_l)
                        array.push(quartile_line_owner_ids, bear_c3_id)
                        if show_bear_c4_fill
                            box bear_c4_open_eq_fill = box.new(left=bar_index, top=math.max(bear_c4_open, c3_equilibrium), right=bar_index + 1, bottom=math.min(bear_c4_open, c3_equilibrium), border_color=na, border_width=0, bgcolor=col_bear_c4_fill)
                            active_bear_c4_fill_b := bear_c4_open_eq_fill
                            array.push(quartile_history_fills, bear_c4_open_eq_fill)
                            array.push(quartile_fill_owner_ids, bear_c3_id)
                        trim_quartile_history()
                    active_bear_cont_b := c4_b
                    active_bear_cont_lbl := c4_lbl
                    active_bear_cont_eq_l := c4_eq_l

                    int c4_mark_time = c15_start_time
                    int c4_mark_idx = ensure_htf_mark(c4_mark_time)
                    HTFMark c4_mark = array.get(htf_marks, c4_mark_idx)
                    c4_mark.xc2 := false
                    c4_mark.xc2_psp := false
                    c4_mark.c4 := true
                    array.set(htf_marks, c4_mark_idx, c4_mark)
                    delete_ltf_xc2_at_time(c4_mark_time)
                    active_bear_c4_time := c4_mark_time

                    if array.size(bear_manips) > 0
                        for i = 0 to array.size(bear_manips) - 1
                            ManipDrawings md = array.get(bear_manips, i)
                            if md.id == bear_c3_id
                                md.cont_b := c4_b
                                md.cont_lbl := c4_lbl
                                md.cont_eq_l := c4_eq_l
                                md.c4_time := c4_mark_time
                                break
        pending_bear_c4 := false

    if allow_bull and pending_bull_c4
        if not will_draw_bull_c3
            float c3_equilibrium = math.avg(c15_h, c15_l)
            if bull_c3_mid <= open
                if use_cont
                    active_bull_c4_invalid_eq := c3_equilibrium
                    box c4_b = na
                    float bull_c4_text_pad = math.max((c15_h - c15_l) * 0.03, syminfo.mintick * 5)
                    label c4_lbl = label.new(x=bar_index, y=c15_l - bull_c4_text_pad, text="C4", style=label.style_none, textcolor=manip_txt_col, size=chart_text_size, textalign=text.align_left)
                    line c4_eq_l = line.new(x1=bar_index, y1=c3_equilibrium, x2=bar_index + 1, y2=c3_equilibrium, color=col_c4_eq_line, style=c4_eq_style, width=c4_eq_width)
                    if show_bull_c4_quartiles
                        float bull_c4_open = open
                        line bull_c4_open_l = line.new(x1=bar_index, y1=bull_c4_open, x2=bar_index + 1, y2=bull_c4_open, color=col_bull_c4_quartile, style=bull_c4_quartile_style, width=bull_c4_quartile_width)
                        active_bull_c4_open_l := bull_c4_open_l
                        array.push(quartile_history_lines, bull_c4_open_l)
                        array.push(quartile_line_owner_ids, bull_c3_id)
                        if show_bull_c4_fill
                            box bull_c4_open_eq_fill = box.new(left=bar_index, top=math.max(bull_c4_open, c3_equilibrium), right=bar_index + 1, bottom=math.min(bull_c4_open, c3_equilibrium), border_color=na, border_width=0, bgcolor=col_bull_c4_fill)
                            active_bull_c4_fill_b := bull_c4_open_eq_fill
                            array.push(quartile_history_fills, bull_c4_open_eq_fill)
                            array.push(quartile_fill_owner_ids, bull_c3_id)
                        trim_quartile_history()
                    active_bull_cont_b := c4_b
                    active_bull_cont_lbl := c4_lbl
                    active_bull_cont_eq_l := c4_eq_l

                    int c4_mark_time = c15_start_time
                    int c4_mark_idx = ensure_htf_mark(c4_mark_time)
                    HTFMark c4_mark = array.get(htf_marks, c4_mark_idx)
                    c4_mark.xc2 := false
                    c4_mark.xc2_psp := false
                    c4_mark.c4 := true
                    array.set(htf_marks, c4_mark_idx, c4_mark)
                    delete_ltf_xc2_at_time(c4_mark_time)
                    active_bull_c4_time := c4_mark_time

                    if array.size(bull_manips) > 0
                        for i = 0 to array.size(bull_manips) - 1
                            ManipDrawings md = array.get(bull_manips, i)
                            if md.id == bull_c3_id
                                md.cont_b := c4_b
                                md.cont_lbl := c4_lbl
                                md.cont_eq_l := c4_eq_l
                                md.c4_time := c4_mark_time
                                break
        pending_bull_c4 := false

    if use_frac
        if allow_bear and p15_h_swept
            if close[1] > p15_h 
                if not na(active_bear_b)
                    delete_cisd_for_manip(active_bear_cisd_owner)
                    delete_ob_for_manip(active_bear_manip_id)
                    delete_sd_projection_for_owner(active_bear_manip_id)
                    delete_quartiles_for_owner(active_bear_manip_id)
                    if not na(active_bear_cisd_l)
                        line.delete(active_bear_cisd_l)
                        active_bear_cisd_l := na
                    if not na(active_bear_cisd_lbl)
                        label.delete(active_bear_cisd_lbl)
                        active_bear_cisd_lbl := na
                    active_bear_cisd_owner := 0
                    bear_cisd_pending := false
                    box.delete(active_bear_b)
                    line.delete(active_bear_l)
                    // This sweep candidate never confirmed as C2. Delete it completely.
                    // xC2 is reserved for a previously confirmed C2 invalidated later.
                    if not na(active_bear_lbl)
                        label.delete(active_bear_lbl)
                    active_bear_b := na
                    active_bear_l := na
                    active_bear_lbl := na
                    
                    active_bear_smt_ok := false
                    if not na(active_bear_smt_live_l)
                        line.delete(active_bear_smt_live_l)
                        active_bear_smt_live_l := na
                    if not na(active_bear_smt_live_lbl)
                        label.delete(active_bear_smt_live_lbl)
                        active_bear_smt_live_lbl := na
                    is_bear_sweeping := false
            else 
                if not na(active_bear_b)
                    
                    // Final C2 PSP on the confirmed manipulation candle.
                    bool bear_c2_psp_s1 = use_psp and psp_dir_disagrees(csmt_c2_o, csmt_c2_c, cs1_o1, cs1_c1, smt_sym1_inverse)
                    bool bear_c2_psp_s2 = use_psp and smt_second_on and psp_dir_disagrees(csmt_c2_o, csmt_c2_c, cs2_o1, cs2_c1, smt_sym2_inverse)
                    bool bear_psp_cond = bear_c2_psp_s1 or bear_c2_psp_s2
                    // C1 PSP belongs to the preceding model candle and becomes meaningful
                    // only now, after this valid C2 model has confirmed.
                    bool bear_c1_psp_s1 = use_psp and psp_dir_disagrees(csmt_c1_o, csmt_c1_c, cs1_o2, cs1_c2, smt_sym1_inverse)
                    bool bear_c1_psp_s2 = use_psp and smt_second_on and psp_dir_disagrees(csmt_c1_o, csmt_c1_c, cs2_o2, cs2_c2, smt_sym2_inverse)
                    bool bear_c1_psp_cond = bear_c1_psp_s1 or bear_c1_psp_s2
                    if bear_c1_psp_cond and not na(csmt_c1_time)
                        int c1_mark_idx = ensure_htf_mark(csmt_c1_time)
                        HTFMark c1_mark = array.get(htf_marks, c1_mark_idx)
                        c1_mark.c2 := false
                        c1_mark.psp := false
                        c1_mark.c1_psp := true
                        c1_mark.psp_name := psp_source_name(bear_c1_psp_s1, bear_c1_psp_s2)
                        c1_mark.psp_above := csmt_c1_c < csmt_c1_o
                        array.set(htf_marks, c1_mark_idx, c1_mark)
                        store_c1_psp_chart_label(csmt_c1_time, csmt_c1_h, csmt_c1_l, csmt_c1_c >= csmt_c1_o)
                    
                    string final_txt = active_bear_smt_ok ? "C2" : "C2" 
                    if bear_psp_cond
                        final_txt += "+PSP"
                    label.set_text(active_bear_lbl, final_txt)

                    int c2_mark_time = csmt_c2_time
                    f_draw_sd_projection(true, c2_mark_time, c15_start_time, sweep_high, active_bear_manip_id)
                    int c2_mark_idx = ensure_htf_mark(c2_mark_time)
                    HTFMark c2_mark = array.get(htf_marks, c2_mark_idx)
                    c2_mark.c1_psp := false
                    c2_mark.xc2 := false
                    c2_mark.xc2_psp := false
                    c2_mark.c3 := false
                    c2_mark.c4 := false
                    c2_mark.c2 := true
                    c2_mark.psp := bear_psp_cond
                    c2_mark.psp_name := psp_source_name(bear_c2_psp_s1, bear_c2_psp_s2)
                    c2_mark.psp_above := true
                    delete_c1_psp_chart_label(c2_mark_time)
                    if active_bear_smt_ok
                        c2_mark.rsmt := true
                        c2_mark.rsmt_bear := true
                        c2_mark.rsmt_name := active_bear_smt_name
                        c2_mark.rsmt_y1 := active_bear_smt_y1
                        c2_mark.rsmt_y2 := active_bear_smt_y2
                        c2_mark.rsmt_t1 := active_bear_smt_t1
                        c2_mark.rsmt_t2 := active_bear_smt_t2
                    array.set(htf_marks, c2_mark_idx, c2_mark)

                    box.set_bgcolor(active_bear_b, col_bear_bg) 
                    label.set_textcolor(active_bear_lbl, manip_txt_col)
                    box.set_border_color(active_bear_b, na)
                    
                    box dist_b = na
                    label dist_lbl = na
                    line dist_eq_l = na 
                    box cont_b = na
                    label cont_lbl = na
                    line cont_eq_l = na
                    
                    if use_dist or use_cont
                        float prev_htf_mid = (c15_h + c15_l) / 2.0
                        float c3_o = open
                        float c3_top = math.max(c3_o, prev_htf_mid)
                        float c3_bot = math.min(c3_o, prev_htf_mid)
                        float c3_mid = math.avg(c3_top, c3_bot)
                        
                        if use_dist
                            dist_b := na
                            float bear_c3_text_pad = math.max((c15_h - c15_l) * 0.03, syminfo.mintick * 5)
                            dist_lbl := label.new(x=bar_index, y=c15_h + bear_c3_text_pad, text="C3", style=label.style_none, textcolor=manip_txt_col, size=chart_text_size, textalign=text.align_left)
                            dist_eq_l := line.new(x1=bar_index, y1=prev_htf_mid, x2=bar_index + 1, y2=prev_htf_mid, color=col_c3_eq_line, style=c3_eq_style, width=c3_eq_width)
                            if show_bear_c3_quartiles
                                float bear_c3_open = open
                                line bear_c3_open_l = line.new(x1=bar_index, y1=bear_c3_open, x2=bar_index + 1, y2=bear_c3_open, color=col_bear_c3_quartile, style=bear_c3_quartile_style, width=bear_c3_quartile_width)
                                array.push(quartile_history_lines, bear_c3_open_l)
                                array.push(quartile_line_owner_ids, active_bear_manip_id)
                                if show_bear_c3_fill
                                    box bear_c3_open_eq_fill = box.new(left=bar_index, top=math.max(bear_c3_open, prev_htf_mid), right=bar_index + 1, bottom=math.min(bear_c3_open, prev_htf_mid), border_color=na, border_width=0, bgcolor=col_bear_c3_fill)
                                    array.push(quartile_history_fills, bear_c3_open_eq_fill)
                                    array.push(quartile_fill_owner_ids, active_bear_manip_id)
                                trim_quartile_history() 
                            active_bear_dist_b := dist_b
                            active_bear_dist_lbl := dist_lbl
                            active_bear_dist_eq_l := dist_eq_l 
                            
                            int c3_mark_time = c15_start_time
                            int c3_mark_idx = ensure_htf_mark(c3_mark_time)
                            HTFMark c3_mark = array.get(htf_marks, c3_mark_idx)
                            c3_mark.xc2 := false
                            c3_mark.xc2_psp := false
                            c3_mark.c3 := true
                            array.set(htf_marks, c3_mark_idx, c3_mark)
                            delete_ltf_xc2_at_time(c3_mark_time)
                            active_bear_c3_time := c3_mark_time
                            
                        pending_bear_c4 := true
                        bear_c3_mid := c3_mid
                        bear_c3_id := active_bear_manip_id
                        
                        active_bear_defense_line := sweep_high 

                    line final_smt_l = na
                    label final_smt_lbl = na
                    if active_bear_smt_ok and smt_history
                        final_smt_l := line.new(x1=active_bear_smt_x1, y1=active_bear_smt_y1, x2=active_bear_smt_x2, y2=active_bear_smt_y2, color=col_smt_bear, width=smt_line_width, style=get_line_style(smt_line_style))
                        final_smt_lbl := label.new(x=get_smt_lbl_x(active_bear_smt_x1, active_bear_smt_x2, smt_text_align), y=math.avg(active_bear_smt_y1, active_bear_smt_y2), text=active_bear_smt_name, style=label.style_none, textcolor=smt_text_color, size=get_text_size(smt_text_size))

                    array.push(bear_manips, ManipDrawings.new(active_bear_b, active_bear_l, active_bear_lbl, dist_b, dist_lbl, dist_eq_l, cont_b, cont_lbl, cont_eq_l, active_bear_manip_id, final_smt_l, final_smt_lbl, active_bear_defense_line, c2_mark_time, bear_psp_cond, active_bear_c3_time, active_bear_c4_time))
                    if array.size(bear_manips) > bear_history
                        ManipDrawings del = array.shift(bear_manips)
                        delete_cisd_for_manip(del.id)
                        delete_ob_for_manip(del.id)
                        delete_sd_projection_for_owner(del.id)
                        delete_quartiles_for_owner(del.id)
                        box.delete(del.b)
                        line.delete(del.l)
                        label.delete(del.lbl)
                        if not na(del.dist_b)
                            box.delete(del.dist_b)
                        if not na(del.dist_lbl)
                            label.delete(del.dist_lbl)
                        if not na(del.dist_eq_l)
                            line.delete(del.dist_eq_l) 
                        if not na(del.cont_b)
                            box.delete(del.cont_b)
                        if not na(del.cont_lbl)
                            label.delete(del.cont_lbl)
                        if not na(del.cont_eq_l)
                            line.delete(del.cont_eq_l)
                        if not na(del.smt_l)
                            line.delete(del.smt_l)
                        if not na(del.smt_lbl)
                            label.delete(del.smt_lbl)
        
        if allow_bull and p15_l_swept
            if close[1] < p15_l 
                if not na(active_bull_b)
                    delete_cisd_for_manip(active_bull_cisd_owner)
                    delete_ob_for_manip(active_bull_manip_id)
                    delete_sd_projection_for_owner(active_bull_manip_id)
                    delete_quartiles_for_owner(active_bull_manip_id)
                    if not na(active_bull_cisd_l)
                        line.delete(active_bull_cisd_l)
                        active_bull_cisd_l := na
                    if not na(active_bull_cisd_lbl)
                        label.delete(active_bull_cisd_lbl)
                        active_bull_cisd_lbl := na
                    active_bull_cisd_owner := 0
                    bull_cisd_pending := false
                    box.delete(active_bull_b)
                    line.delete(active_bull_l)
                    // This sweep candidate never confirmed as C2. Delete it completely.
                    // xC2 is reserved for a previously confirmed C2 invalidated later.
                    if not na(active_bull_lbl)
                        label.delete(active_bull_lbl)
                    active_bull_b := na
                    active_bull_l := na
                    active_bull_lbl := na
                    
                    active_bull_smt_ok := false
                    if not na(active_bull_smt_live_l)
                        line.delete(active_bull_smt_live_l)
                        active_bull_smt_live_l := na
                    if not na(active_bull_smt_live_lbl)
                        label.delete(active_bull_smt_live_lbl)
                        active_bull_smt_live_lbl := na
                    is_bull_sweeping := false
            else 
                if not na(active_bull_b)

                    // Final C2 PSP on the confirmed manipulation candle.
                    bool bull_c2_psp_s1 = use_psp and psp_dir_disagrees(csmt_c2_o, csmt_c2_c, cs1_o1, cs1_c1, smt_sym1_inverse)
                    bool bull_c2_psp_s2 = use_psp and smt_second_on and psp_dir_disagrees(csmt_c2_o, csmt_c2_c, cs2_o1, cs2_c1, smt_sym2_inverse)
                    bool bull_psp_cond = bull_c2_psp_s1 or bull_c2_psp_s2
                    // Confirm and store C1 PSP only inside this now-valid fractal model.
                    bool bull_c1_psp_s1 = use_psp and psp_dir_disagrees(csmt_c1_o, csmt_c1_c, cs1_o2, cs1_c2, smt_sym1_inverse)
                    bool bull_c1_psp_s2 = use_psp and smt_second_on and psp_dir_disagrees(csmt_c1_o, csmt_c1_c, cs2_o2, cs2_c2, smt_sym2_inverse)
                    bool bull_c1_psp_cond = bull_c1_psp_s1 or bull_c1_psp_s2
                    if bull_c1_psp_cond and not na(csmt_c1_time)
                        int c1_mark_idx = ensure_htf_mark(csmt_c1_time)
                        HTFMark c1_mark = array.get(htf_marks, c1_mark_idx)
                        c1_mark.c2 := false
                        c1_mark.psp := false
                        c1_mark.c1_psp := true
                        c1_mark.psp_name := psp_source_name(bull_c1_psp_s1, bull_c1_psp_s2)
                        c1_mark.psp_above := csmt_c1_c < csmt_c1_o
                        array.set(htf_marks, c1_mark_idx, c1_mark)
                        store_c1_psp_chart_label(csmt_c1_time, csmt_c1_h, csmt_c1_l, csmt_c1_c >= csmt_c1_o)
                    
                    string final_txt = active_bull_smt_ok ? "C2" : "C2"
                    if bull_psp_cond
                        final_txt += "+PSP"
                    label.set_text(active_bull_lbl, final_txt)

                    int c2_mark_time = csmt_c2_time
                    f_draw_sd_projection(false, c2_mark_time, c15_start_time, sweep_low, active_bull_manip_id)
                    int c2_mark_idx = ensure_htf_mark(c2_mark_time)
                    HTFMark c2_mark = array.get(htf_marks, c2_mark_idx)
                    c2_mark.c1_psp := false
                    c2_mark.xc2 := false
                    c2_mark.xc2_psp := false
                    c2_mark.c3 := false
                    c2_mark.c4 := false
                    c2_mark.c2 := true
                    c2_mark.psp := bull_psp_cond
                    c2_mark.psp_name := psp_source_name(bull_c2_psp_s1, bull_c2_psp_s2)
                    c2_mark.psp_above := false
                    delete_c1_psp_chart_label(c2_mark_time)
                    if active_bull_smt_ok
                        c2_mark.rsmt := true
                        c2_mark.rsmt_bear := false
                        c2_mark.rsmt_name := active_bull_smt_name
                        c2_mark.rsmt_y1 := active_bull_smt_y1
                        c2_mark.rsmt_y2 := active_bull_smt_y2
                        c2_mark.rsmt_t1 := active_bull_smt_t1
                        c2_mark.rsmt_t2 := active_bull_smt_t2
                    array.set(htf_marks, c2_mark_idx, c2_mark)

                    box.set_bgcolor(active_bull_b, col_bull_bg) 
                    label.set_textcolor(active_bull_lbl, manip_txt_col)
                    box.set_border_color(active_bull_b, na)
                    
                    box dist_b = na
                    label dist_lbl = na
                    line dist_eq_l = na 
                    box cont_b = na
                    label cont_lbl = na
                    line cont_eq_l = na
                    
                    if use_dist or use_cont
                        float prev_htf_mid = (c15_h + c15_l) / 2.0
                        float c3_o = open
                        float c3_top = math.max(c3_o, prev_htf_mid)
                        float c3_bot = math.min(c3_o, prev_htf_mid)
                        float c3_mid = math.avg(c3_top, c3_bot)
                        
                        if use_dist
                            dist_b := na
                            float bull_c3_text_pad = math.max((c15_h - c15_l) * 0.03, syminfo.mintick * 5)
                            dist_lbl := label.new(x=bar_index, y=c15_l - bull_c3_text_pad, text="C3", style=label.style_none, textcolor=manip_txt_col, size=chart_text_size, textalign=text.align_left)
                            dist_eq_l := line.new(x1=bar_index, y1=prev_htf_mid, x2=bar_index + 1, y2=prev_htf_mid, color=col_c3_eq_line, style=c3_eq_style, width=c3_eq_width)
                            if show_bull_c3_quartiles
                                float bull_c3_open = open
                                line bull_c3_open_l = line.new(x1=bar_index, y1=bull_c3_open, x2=bar_index + 1, y2=bull_c3_open, color=col_bull_c3_quartile, style=bull_c3_quartile_style, width=bull_c3_quartile_width)
                                array.push(quartile_history_lines, bull_c3_open_l)
                                array.push(quartile_line_owner_ids, active_bull_manip_id)
                                if show_bull_c3_fill
                                    box bull_c3_open_eq_fill = box.new(left=bar_index, top=math.max(bull_c3_open, prev_htf_mid), right=bar_index + 1, bottom=math.min(bull_c3_open, prev_htf_mid), border_color=na, border_width=0, bgcolor=col_bull_c3_fill)
                                    array.push(quartile_history_fills, bull_c3_open_eq_fill)
                                    array.push(quartile_fill_owner_ids, active_bull_manip_id)
                                trim_quartile_history() 
                            active_bull_dist_b := dist_b
                            active_bull_dist_lbl := dist_lbl
                            active_bull_dist_eq_l := dist_eq_l 
                            
                            int c3_mark_time = c15_start_time
                            int c3_mark_idx = ensure_htf_mark(c3_mark_time)
                            HTFMark c3_mark = array.get(htf_marks, c3_mark_idx)
                            c3_mark.xc2 := false
                            c3_mark.xc2_psp := false
                            c3_mark.c3 := true
                            array.set(htf_marks, c3_mark_idx, c3_mark)
                            delete_ltf_xc2_at_time(c3_mark_time)
                            active_bull_c3_time := c3_mark_time
                            
                        pending_bull_c4 := true
                        bull_c3_mid := c3_mid
                        bull_c3_id := active_bull_manip_id
                            
                        active_bull_defense_line := sweep_low 

                    line final_smt_l = na
                    label final_smt_lbl = na
                    if active_bull_smt_ok and smt_history
                        final_smt_l := line.new(x1=active_bull_smt_x1, y1=active_bull_smt_y1, x2=active_bull_smt_x2, y2=active_bull_smt_y2, color=col_smt_bull, width=smt_line_width, style=get_line_style(smt_line_style))
                        final_smt_lbl := label.new(x=get_smt_lbl_x(active_bull_smt_x1, active_bull_smt_x2, smt_text_align), y=math.avg(active_bull_smt_y1, active_bull_smt_y2), text=active_bull_smt_name, style=label.style_none, textcolor=smt_text_color, size=get_text_size(smt_text_size))

                    array.push(bull_manips, ManipDrawings.new(active_bull_b, active_bull_l, active_bull_lbl, dist_b, dist_lbl, dist_eq_l, cont_b, cont_lbl, cont_eq_l, active_bull_manip_id, final_smt_l, final_smt_lbl, active_bull_defense_line, c2_mark_time, bull_psp_cond, active_bull_c3_time, active_bull_c4_time))
                    if array.size(bull_manips) > bull_history
                        ManipDrawings del = array.shift(bull_manips)
                        delete_cisd_for_manip(del.id)
                        delete_ob_for_manip(del.id)
                        delete_sd_projection_for_owner(del.id)
                        delete_quartiles_for_owner(del.id)
                        box.delete(del.b)
                        line.delete(del.l)
                        label.delete(del.lbl)
                        if not na(del.dist_b)
                            box.delete(del.dist_b)
                        if not na(del.dist_lbl)
                            label.delete(del.dist_lbl)
                        if not na(del.dist_eq_l)
                            line.delete(del.dist_eq_l) 
                        if not na(del.cont_b)
                            box.delete(del.cont_b)
                        if not na(del.cont_lbl)
                            label.delete(del.cont_lbl)
                        if not na(del.cont_eq_l)
                            line.delete(del.cont_eq_l)
                        if not na(del.smt_l)
                            line.delete(del.smt_l)
                        if not na(del.smt_lbl)
                            label.delete(del.smt_lbl)

    p15_h := c15_h, p15_h_bar := c15_h_bar
    p15_l := c15_l, p15_l_bar := c15_l_bar
    
    c15_h := high, c15_h_bar := bar_index
    c15_l := low,  c15_l_bar := bar_index
    c15_start_bar := bar_index
    c15_open := open 
    
    p15_h_swept := false, p15_l_swept := false
    
    is_bear_sweeping := false, active_bear_b := na, active_bear_l := na, active_bear_lbl := na, active_bear_manip_id := 0
    is_bull_sweeping := false, active_bull_b := na, active_bull_l := na, active_bull_lbl := na, active_bull_manip_id := 0
    
    active_bear_smt_ok := false, active_bull_smt_ok := false
    if not na(active_bear_smt_live_l)
        line.delete(active_bear_smt_live_l)
        active_bear_smt_live_l := na
    if not na(active_bear_smt_live_lbl)
        label.delete(active_bear_smt_live_lbl)
        active_bear_smt_live_lbl := na
    if not na(active_bull_smt_live_l)
        line.delete(active_bull_smt_live_l)
        active_bull_smt_live_l := na
    if not na(active_bull_smt_live_lbl)
        label.delete(active_bull_smt_live_lbl)
        active_bull_smt_live_lbl := na
else
    if high > c15_h
        c15_h := high, c15_h_bar := bar_index
    if low < c15_l
        c15_l := low, c15_l_bar := bar_index
        
    if not na(smt_tracker_curr.h) and high > smt_tracker_curr.h
        smt_tracker_curr.h := high
        smt_tracker_curr.h_idx := bar_index
        smt_tracker_curr.h_t := nz(time(active_htf_tf), time)
    if not na(smt_tracker_curr.l) and low < smt_tracker_curr.l
        smt_tracker_curr.l := low
        smt_tracker_curr.l_idx := bar_index
        smt_tracker_curr.l_t := nz(time(active_htf_tf), time)

    if not na(smt_sym1_h) and (na(smt_tracker1.h) or smt_sym1_h > smt_tracker1.h)
        smt_tracker1.h := smt_sym1_h
        smt_tracker1.h_idx := bar_index
        smt_tracker1.h_t := nz(time(active_htf_tf), time)
    if not na(smt_sym1_l) and (na(smt_tracker1.l) or smt_sym1_l < smt_tracker1.l)
        smt_tracker1.l := smt_sym1_l
        smt_tracker1.l_idx := bar_index
        smt_tracker1.l_t := nz(time(active_htf_tf), time)

    if smt_second_on and not na(smt_sym2_h) and (na(smt_tracker2.h) or smt_sym2_h > smt_tracker2.h)
        smt_tracker2.h := smt_sym2_h
        smt_tracker2.h_idx := bar_index
        smt_tracker2.h_t := nz(time(active_htf_tf), time)
    if smt_second_on and not na(smt_sym2_l) and (na(smt_tracker2.l) or smt_sym2_l < smt_tracker2.l)
        smt_tracker2.l := smt_sym2_l
        smt_tracker2.l_idx := bar_index
        smt_tracker2.l_t := nz(time(active_htf_tf), time)

// --- LIVE DYNAMIC C3/C4 TEXT PLACEMENT BY SWING HIGH/LOW ---
float c3_c4_text_swing_pad = math.max((c15_h - c15_l) * 0.03, syminfo.mintick * 5)
if not na(active_bear_dist_lbl)
    label.set_y(active_bear_dist_lbl, c15_h + c3_c4_text_swing_pad)
if not na(active_bear_cont_lbl)
    label.set_y(active_bear_cont_lbl, c15_h + c3_c4_text_swing_pad)
if not na(active_bull_dist_lbl)
    label.set_y(active_bull_dist_lbl, c15_l - c3_c4_text_swing_pad)
if not na(active_bull_cont_lbl)
    label.set_y(active_bull_cont_lbl, c15_l - c3_c4_text_swing_pad)

// --- LIVE DYNAMIC C3/C4 OPEN + EQ + FILL EXTENSION ---
// Current C3/C4 drawings end only at the latest printed chart bar.
// They grow one bar at a time and stop automatically when the next HTF candle starts.
if not na(active_bear_dist_eq_l)
    line.set_x2(active_bear_dist_eq_l, bar_index + 1)
if not na(active_bull_dist_eq_l)
    line.set_x2(active_bull_dist_eq_l, bar_index + 1)
if not na(active_bear_cont_eq_l)
    line.set_x2(active_bear_cont_eq_l, bar_index + 1)
if not na(active_bull_cont_eq_l)
    line.set_x2(active_bull_cont_eq_l, bar_index + 1)

// Opening-price lines are stored in this history array. Extend only objects
// belonging to the currently printing HTF candle.
if array.size(quartile_history_lines) > 0
    for dynamic_i = 0 to array.size(quartile_history_lines) - 1
        line dynamic_open_line = array.get(quartile_history_lines, dynamic_i)
        if line.get_x1(dynamic_open_line) == c15_start_bar
            line.set_x2(dynamic_open_line, bar_index + 1)

// Open-to-EQ fill follows the same live right edge.
if array.size(quartile_history_fills) > 0
    for dynamic_i = 0 to array.size(quartile_history_fills) - 1
        box dynamic_open_eq_fill = array.get(quartile_history_fills, dynamic_i)
        if box.get_left(dynamic_open_eq_fill) == c15_start_bar
            box.set_right(dynamic_open_eq_fill, bar_index + 1)

// ==========================================================
// xC4 INVALIDATION: LTF BODY CLOSE THROUGH FIXED C3 EQ
// Bullish C4: an LTF close below C3 EQ invalidates C4.
// Bearish C4: an LTF close above C3 EQ invalidates C4.
// Wick-only penetration and equality do not invalidate C4.
// This check is active only during the C4 HTF candle because
// active references reset when the next HTF candle begins.
// ==========================================================
bool bear_c4_invalid = barstate.isconfirmed and use_cont and allow_bear and not na(active_bear_cont_lbl) and not na(active_bear_c4_invalid_eq) and close > active_bear_c4_invalid_eq
if bear_c4_invalid
    label.set_text(active_bear_cont_lbl, "xC4")
    label.set_textcolor(active_bear_cont_lbl, color.red)
    if not na(active_bear_cont_b)
        box.delete(active_bear_cont_b)
    if not na(active_bear_cont_eq_l)
        line.delete(active_bear_cont_eq_l)
    if not na(active_bear_c4_open_l)
        line.delete(active_bear_c4_open_l)
    if not na(active_bear_c4_fill_b)
        box.delete(active_bear_c4_fill_b)
    if not na(active_bear_c4_time)
        int inv_bear_c4_idx = get_htf_mark_index(active_bear_c4_time)
        if inv_bear_c4_idx >= 0
            HTFMark inv_bear_c4_mark = array.get(htf_marks, inv_bear_c4_idx)
            inv_bear_c4_mark.c4 := false
            array.set(htf_marks, inv_bear_c4_idx, inv_bear_c4_mark)
    active_bear_cont_b := na
    active_bear_cont_lbl := na
    active_bear_cont_eq_l := na
    active_bear_c4_open_l := na
    active_bear_c4_fill_b := na
    active_bear_c4_time := na
    active_bear_c4_invalid_eq := na

bool bull_c4_invalid = barstate.isconfirmed and use_cont and allow_bull and not na(active_bull_cont_lbl) and not na(active_bull_c4_invalid_eq) and close < active_bull_c4_invalid_eq
if bull_c4_invalid
    label.set_text(active_bull_cont_lbl, "xC4")
    label.set_textcolor(active_bull_cont_lbl, color.red)
    if not na(active_bull_cont_b)
        box.delete(active_bull_cont_b)
    if not na(active_bull_cont_eq_l)
        line.delete(active_bull_cont_eq_l)
    if not na(active_bull_c4_open_l)
        line.delete(active_bull_c4_open_l)
    if not na(active_bull_c4_fill_b)
        box.delete(active_bull_c4_fill_b)
    if not na(active_bull_c4_time)
        int inv_bull_c4_idx = get_htf_mark_index(active_bull_c4_time)
        if inv_bull_c4_idx >= 0
            HTFMark inv_bull_c4_mark = array.get(htf_marks, inv_bull_c4_idx)
            inv_bull_c4_mark.c4 := false
            array.set(htf_marks, inv_bull_c4_idx, inv_bull_c4_mark)
    active_bull_cont_b := na
    active_bull_cont_lbl := na
    active_bull_cont_eq_l := na
    active_bull_c4_open_l := na
    active_bull_c4_fill_b := na
    active_bull_c4_time := na
    active_bull_c4_invalid_eq := na

if array.size(bear_manips) > 0
    for i = array.size(bear_manips) - 1 to 0
        ManipDrawings md = array.get(bear_manips, i)
        if not na(md.def_line) and high >= md.def_line
            if not na(md.c3_time)
                int idx3 = get_htf_mark_index(md.c3_time)
                if idx3 >= 0
                    HTFMark mk = array.get(htf_marks, idx3)
                    mk.c3 := false
                    array.set(htf_marks, idx3, mk)
            if not na(md.c4_time)
                int idx4 = get_htf_mark_index(md.c4_time)
                if idx4 >= 0
                    HTFMark mk = array.get(htf_marks, idx4)
                    mk.c4 := false
                    array.set(htf_marks, idx4, mk)
                    
            box.delete(md.b)
            line.delete(md.l)
            bool bear_old_c2_has_psp = use_psp and md.c2_psp
            store_xc2_label(md.lbl, bear_xc2_history, bear_xc2_times, md.c2_time, bear_history, bear_old_c2_has_psp)
            if not na(md.dist_b)
                box.delete(md.dist_b)
            if not na(md.dist_lbl)
                label.delete(md.dist_lbl)
                if not na(md.dist_eq_l)               
                    line.delete(md.dist_eq_l)         
            if not na(md.cont_b)
                box.delete(md.cont_b)
            if not na(md.cont_lbl)
                label.delete(md.cont_lbl)
            if not na(md.cont_eq_l)
                line.delete(md.cont_eq_l)
            if not na(md.smt_l)
                line.delete(md.smt_l)
            if not na(md.smt_lbl)
                label.delete(md.smt_lbl)
            delete_cisd_for_manip(md.id)
            delete_ob_for_manip(md.id)
            delete_sd_projection_for_owner(md.id)
            delete_quartiles_for_owner(md.id)
            array.remove(bear_manips, i)

if array.size(bull_manips) > 0
    for i = array.size(bull_manips) - 1 to 0
        ManipDrawings md = array.get(bull_manips, i)
        if not na(md.def_line) and low <= md.def_line
            if not na(md.c3_time)
                int idx3 = get_htf_mark_index(md.c3_time)
                if idx3 >= 0
                    HTFMark mk = array.get(htf_marks, idx3)
                    mk.c3 := false
                    array.set(htf_marks, idx3, mk)
            if not na(md.c4_time)
                int idx4 = get_htf_mark_index(md.c4_time)
                if idx4 >= 0
                    HTFMark mk = array.get(htf_marks, idx4)
                    mk.c4 := false
                    array.set(htf_marks, idx4, mk)
                    
            box.delete(md.b)
            line.delete(md.l)
            bool bull_old_c2_has_psp = use_psp and md.c2_psp
            store_xc2_label(md.lbl, bull_xc2_history, bull_xc2_times, md.c2_time, bull_history, bull_old_c2_has_psp)
            if not na(md.dist_b)
                box.delete(md.dist_b)
            if not na(md.dist_lbl)
                label.delete(md.dist_lbl)
                if not na(md.dist_eq_l)               
                    line.delete(md.dist_eq_l)         
            if not na(md.cont_b)
                box.delete(md.cont_b)
            if not na(md.cont_lbl)
                label.delete(md.cont_lbl)
            if not na(md.cont_eq_l)
                line.delete(md.cont_eq_l)
            if not na(md.smt_l)
                line.delete(md.smt_l)
            if not na(md.smt_lbl)
                label.delete(md.smt_lbl)
            delete_cisd_for_manip(md.id)
            delete_ob_for_manip(md.id)
            delete_sd_projection_for_owner(md.id)
            delete_quartiles_for_owner(md.id)
            array.remove(bull_manips, i)

// ==========================================
// C2 MANIPULATION + PSP RECOGNITION
// ==========================================
if use_frac and not na(p15_h) and not na(p15_l)
    // --- BEARISH SWEEP INIT ---
    if allow_bear and not p15_h_swept and high > p15_h
        p15_h_swept := true
        is_bear_sweeping := true
        sweep_high := high
        bear_new_high_made := true 
            
        next_manip_id += 1
        active_bear_manip_id := next_manip_id
        bear_cisd_done_owner := 0
        latest_bear_manip_id := next_manip_id
        latest_bear_manip_start := c15_start_bar
        
        active_bear_b := box.new(left=c15_start_bar, top=sweep_high, right=c15_start_bar + matched_bar_count, bottom=p15_h, border_color=na, bgcolor=na, border_width=0)
        active_bear_l := line.new(x1=p15_h_bar, y1=p15_h, x2=c15_start_bar + matched_bar_count, y2=p15_h, color=col_bear_line, width=1)
        
        active_bear_smt_ok := false
        if use_smt
            [bear_smt_ok, bear_smt_x1, bear_smt_x2, bear_smt_y1, bear_smt_y2, bear_smt_t1, bear_smt_t2, bear_smt_name] = CheckSMTDivergence(true, smt_tracker_curr, smt_tracker1, smt_tracker2, true, smt_second_on, smt_sym1_inverse, smt_sym2_inverse, smt_sym1_ticker, smt_sym2_ticker)
            if bear_smt_ok
                active_bear_smt_ok := true
                active_bear_smt_x1 := bear_smt_x1
                active_bear_smt_x2 := bear_smt_x2
                active_bear_smt_y1 := bear_smt_y1
                active_bear_smt_y2 := bear_smt_y2
                active_bear_smt_t1 := bear_smt_t1
                active_bear_smt_t2 := bear_smt_t2
                active_bear_smt_name := bear_smt_name
        
        active_bear_lbl := label.new(x=c15_start_bar + int(math.round(matched_bar_count / 2.0)), y=sweep_high + math.max((sweep_high - p15_h) * 0.08, syminfo.mintick * 10), text="C2", style=label.style_none, textcolor=na, size=chart_text_size, textalign=text.align_center)

    // --- BEARISH SWEEP UPDATE ---
    if allow_bear and is_bear_sweeping and not na(active_bear_b)
        if high > sweep_high
            sweep_high := high
            bear_new_high_made := true 
            box.set_top(active_bear_b, sweep_high)
            label.set_y(active_bear_lbl, sweep_high + math.max((sweep_high - p15_h) * 0.08, syminfo.mintick * 10))

        if use_smt
            [bear_smt_ok, bear_smt_x1, bear_smt_x2, bear_smt_y1, bear_smt_y2, bear_smt_t1, bear_smt_t2, bear_smt_name] = CheckSMTDivergence(true, smt_tracker_curr, smt_tracker1, smt_tracker2, true, smt_second_on, smt_sym1_inverse, smt_sym2_inverse, smt_sym1_ticker, smt_sym2_ticker)
            if bear_smt_ok
                active_bear_smt_ok := true
                active_bear_smt_x1 := bear_smt_x1
                active_bear_smt_x2 := bear_smt_x2
                active_bear_smt_y1 := bear_smt_y1
                active_bear_smt_y2 := bear_smt_y2
                active_bear_smt_t1 := bear_smt_t1
                active_bear_smt_t2 := bear_smt_t2
                active_bear_smt_name := bear_smt_name
            else
                active_bear_smt_ok := false
        else
            active_bear_smt_ok := false

        bool bear_live_psp_s1 = use_psp and psp_dir_disagrees(c15_open, close, cs1_live_o, cs1_live_c, smt_sym1_inverse)
        bool bear_live_psp_s2 = use_psp and smt_second_on and psp_dir_disagrees(c15_open, close, cs2_live_o, cs2_live_c, smt_sym2_inverse)
        bool bear_live_psp = bear_live_psp_s1 or bear_live_psp_s2

        if close <= p15_h
            box.set_bgcolor(active_bear_b, col_bear_bg)
            label.set_textcolor(active_bear_lbl, manip_txt_col)
            box.set_border_color(active_bear_b, na)

            string bear_live_txt = "C2"
            if active_bear_smt_ok
                bear_live_txt += ""
            if bear_live_psp
                bear_live_txt += "+PSP"
            label.set_text(active_bear_lbl, bear_live_txt)

            if use_smt and active_bear_smt_ok
                if not na(active_bear_smt_live_l)
                    line.delete(active_bear_smt_live_l)
                if not na(active_bear_smt_live_lbl)
                    label.delete(active_bear_smt_live_lbl)
                active_bear_smt_live_l := line.new(x1=active_bear_smt_x1, y1=active_bear_smt_y1, x2=active_bear_smt_x2, y2=active_bear_smt_y2, color=col_smt_bear, width=smt_line_width, style=get_line_style(smt_line_style))
                active_bear_smt_live_lbl := label.new(x=get_smt_lbl_x(active_bear_smt_x1, active_bear_smt_x2, smt_text_align), y=math.avg(active_bear_smt_y1, active_bear_smt_y2), text=active_bear_smt_name, style=label.style_none, textcolor=smt_text_color, size=get_text_size(smt_text_size), textalign=text.align_center)
            else
                if not na(active_bear_smt_live_l)
                    line.delete(active_bear_smt_live_l)
                    active_bear_smt_live_l := na
                if not na(active_bear_smt_live_lbl)
                    label.delete(active_bear_smt_live_lbl)
                    active_bear_smt_live_lbl := na

            int bear_live_mark_time = c15_start_time
            int bear_live_mark_idx = ensure_htf_mark(bear_live_mark_time)
            HTFMark bear_live_mark = array.get(htf_marks, bear_live_mark_idx)
            bear_live_mark.c1_psp := false
            bear_live_mark.xc2 := false
            bear_live_mark.xc2_psp := false
            bear_live_mark.c3 := false
            bear_live_mark.c4 := false
            bear_live_mark.c2 := true
            bear_live_mark.psp := bear_live_psp
            bear_live_mark.psp_name := psp_source_name(bear_live_psp_s1, bear_live_psp_s2)
            bear_live_mark.psp_above := true
            delete_c1_psp_chart_label(bear_live_mark_time)
            bear_live_mark.rsmt := active_bear_smt_ok
            bear_live_mark.rsmt_bear := true
            bear_live_mark.rsmt_name := active_bear_smt_ok ? active_bear_smt_name : ""
            bear_live_mark.rsmt_y1 := active_bear_smt_ok ? active_bear_smt_y1 : na
            bear_live_mark.rsmt_y2 := active_bear_smt_ok ? active_bear_smt_y2 : na
            bear_live_mark.rsmt_t1 := active_bear_smt_ok ? active_bear_smt_t1 : na
            bear_live_mark.rsmt_t2 := active_bear_smt_ok ? active_bear_smt_t2 : na
            array.set(htf_marks, bear_live_mark_idx, bear_live_mark)
        else
            box.set_bgcolor(active_bear_b, na)
            label.set_textcolor(active_bear_lbl, na)
            box.set_border_color(active_bear_b, na)
            label.set_text(active_bear_lbl, "")
            
            if not na(active_bear_smt_live_l)
                line.delete(active_bear_smt_live_l)
                active_bear_smt_live_l := na
            if not na(active_bear_smt_live_lbl)
                label.delete(active_bear_smt_live_lbl)
                active_bear_smt_live_lbl := na
                
            int bear_live_mark_time = c15_start_time
            int bear_live_mark_idx = ensure_htf_mark(bear_live_mark_time)
            HTFMark bear_live_mark = array.get(htf_marks, bear_live_mark_idx)
            bear_live_mark.c2 := false
            bear_live_mark.psp := false
            bear_live_mark.psp_name := ""
            bear_live_mark.rsmt := false
            bear_live_mark.rsmt_name := ""
            bear_live_mark.rsmt_y1 := na
            bear_live_mark.rsmt_y2 := na
            bear_live_mark.rsmt_t1 := na
            bear_live_mark.rsmt_t2 := na
            array.set(htf_marks, bear_live_mark_idx, bear_live_mark)

    // --- BULLISH SWEEP INIT ---
    if allow_bull and not p15_l_swept and low < p15_l
        p15_l_swept := true
        is_bull_sweeping := true
        sweep_low := low
        bull_new_low_made := true 
            
        next_manip_id += 1
        active_bull_manip_id := next_manip_id
        bull_cisd_done_owner := 0
        latest_bull_manip_id := next_manip_id
        latest_bull_manip_start := c15_start_bar

        active_bull_b := box.new(left=c15_start_bar, top=p15_l, right=c15_start_bar + matched_bar_count, bottom=sweep_low, border_color=na, bgcolor=na, border_width=0)
        active_bull_l := line.new(x1=p15_l_bar, y1=p15_l, x2=c15_start_bar + matched_bar_count, y2=p15_l, color=col_bull_line, width=1)

        active_bull_smt_ok := false
        if use_smt
            [bull_smt_ok, bull_smt_x1, bull_smt_x2, bull_smt_y1, bull_smt_y2, bull_smt_t1, bull_smt_t2, bull_smt_name] = CheckSMTDivergence(false, smt_tracker_curr, smt_tracker1, smt_tracker2, true, smt_second_on, smt_sym1_inverse, smt_sym2_inverse, smt_sym1_ticker, smt_sym2_ticker)
            if bull_smt_ok
                active_bull_smt_ok := true
                active_bull_smt_x1 := bull_smt_x1
                active_bull_smt_x2 := bull_smt_x2
                active_bull_smt_y1 := bull_smt_y1
                active_bull_smt_y2 := bull_smt_y2
                active_bull_smt_t1 := bull_smt_t1
                active_bull_smt_t2 := bull_smt_t2
                active_bull_smt_name := bull_smt_name

        active_bull_lbl := label.new(x=c15_start_bar + int(math.round(matched_bar_count / 2.0)), y=sweep_low - math.max((p15_l - sweep_low) * 0.08, syminfo.mintick * 10), text="C2", style=label.style_none, textcolor=na, size=chart_text_size, textalign=text.align_center)

    // --- BULLISH SWEEP UPDATE ---
    if allow_bull and is_bull_sweeping and not na(active_bull_b)
        if low < sweep_low
            sweep_low := low
            bull_new_low_made := true 
            box.set_bottom(active_bull_b, sweep_low)
            label.set_y(active_bull_lbl, sweep_low - math.max((p15_l - sweep_low) * 0.08, syminfo.mintick * 10))

        if use_smt
            [bull_smt_ok, bull_smt_x1, bull_smt_x2, bull_smt_y1, bull_smt_y2, bull_smt_t1, bull_smt_t2, bull_smt_name] = CheckSMTDivergence(false, smt_tracker_curr, smt_tracker1, smt_tracker2, true, smt_second_on, smt_sym1_inverse, smt_sym2_inverse, smt_sym1_ticker, smt_sym2_ticker)
            if bull_smt_ok
                active_bull_smt_ok := true
                active_bull_smt_x1 := bull_smt_x1
                active_bull_smt_x2 := bull_smt_x2
                active_bull_smt_y1 := bull_smt_y1
                active_bull_smt_y2 := bull_smt_y2
                active_bull_smt_t1 := bull_smt_t1
                active_bull_smt_t2 := bull_smt_t2
                active_bull_smt_name := bull_smt_name
            else
                active_bull_smt_ok := false
        else
            active_bull_smt_ok := false

        bool bull_live_psp_s1 = use_psp and psp_dir_disagrees(c15_open, close, cs1_live_o, cs1_live_c, smt_sym1_inverse)
        bool bull_live_psp_s2 = use_psp and smt_second_on and psp_dir_disagrees(c15_open, close, cs2_live_o, cs2_live_c, smt_sym2_inverse)
        bool bull_live_psp = bull_live_psp_s1 or bull_live_psp_s2

        if close >= p15_l
            box.set_bgcolor(active_bull_b, col_bull_bg)
            label.set_textcolor(active_bull_lbl, manip_txt_col)
            box.set_border_color(active_bull_b, na)

            string bull_live_txt = "C2"
            if active_bull_smt_ok
                bull_live_txt += ""
            if bull_live_psp
                bull_live_txt += "+PSP"
            label.set_text(active_bull_lbl, bull_live_txt)

            if use_smt and active_bull_smt_ok
                if not na(active_bull_smt_live_l)
                    line.delete(active_bull_smt_live_l)
                if not na(active_bull_smt_live_lbl)
                    label.delete(active_bull_smt_live_lbl)
                active_bull_smt_live_l := line.new(x1=active_bull_smt_x1, y1=active_bull_smt_y1, x2=active_bull_smt_x2, y2=active_bull_smt_y2, color=col_smt_bull, width=smt_line_width, style=get_line_style(smt_line_style))
                active_bull_smt_live_lbl := label.new(x=get_smt_lbl_x(active_bull_smt_x1, active_bull_smt_x2, smt_text_align), y=math.avg(active_bull_smt_y1, active_bull_smt_y2), text=active_bull_smt_name, style=label.style_none, textcolor=smt_text_color, size=get_text_size(smt_text_size), textalign=text.align_center)
            else
                if not na(active_bull_smt_live_l)
                    line.delete(active_bull_smt_live_l)
                    active_bull_smt_live_l := na
                if not na(active_bull_smt_live_lbl)
                    label.delete(active_bull_smt_live_lbl)
                    active_bull_smt_live_lbl := na

            int bull_live_mark_time = c15_start_time
            int bull_live_mark_idx = ensure_htf_mark(bull_live_mark_time)
            HTFMark bull_live_mark = array.get(htf_marks, bull_live_mark_idx)
            bull_live_mark.c1_psp := false
            bull_live_mark.xc2 := false
            bull_live_mark.xc2_psp := false
            bull_live_mark.c3 := false
            bull_live_mark.c4 := false
            bull_live_mark.c2 := true
            bull_live_mark.psp := bull_live_psp
            bull_live_mark.psp_name := psp_source_name(bull_live_psp_s1, bull_live_psp_s2)
            bull_live_mark.psp_above := false
            delete_c1_psp_chart_label(bull_live_mark_time)
            bull_live_mark.rsmt := active_bull_smt_ok
            bull_live_mark.rsmt_bear := false
            bull_live_mark.rsmt_name := active_bull_smt_ok ? active_bull_smt_name : ""
            bull_live_mark.rsmt_y1 := active_bull_smt_ok ? active_bull_smt_y1 : na
            bull_live_mark.rsmt_y2 := active_bull_smt_ok ? active_bull_smt_y2 : na
            bull_live_mark.rsmt_t1 := active_bull_smt_ok ? active_bull_smt_t1 : na
            bull_live_mark.rsmt_t2 := active_bull_smt_ok ? active_bull_smt_t2 : na
            array.set(htf_marks, bull_live_mark_idx, bull_live_mark)
        else
            box.set_bgcolor(active_bull_b, na)
            label.set_textcolor(active_bull_lbl, na)
            box.set_border_color(active_bull_b, na)
            label.set_text(active_bull_lbl, "")
            
            if not na(active_bull_smt_live_l)
                line.delete(active_bull_smt_live_l)
                active_bull_smt_live_l := na
            if not na(active_bull_smt_live_lbl)
                label.delete(active_bull_smt_live_lbl)
                active_bull_smt_live_lbl := na
                
            int bull_live_mark_time = c15_start_time
            int bull_live_mark_idx = ensure_htf_mark(bull_live_mark_time)
            HTFMark bull_live_mark = array.get(htf_marks, bull_live_mark_idx)
            bull_live_mark.c2 := false
            bull_live_mark.psp := false
            bull_live_mark.psp_name := ""
            bull_live_mark.rsmt := false
            bull_live_mark.rsmt_name := ""
            bull_live_mark.rsmt_y1 := na
            bull_live_mark.rsmt_y2 := na
            bull_live_mark.rsmt_t1 := na
            bull_live_mark.rsmt_t2 := na
            array.set(htf_marks, bull_live_mark_idx, bull_live_mark)


// ==========================================================
// FINAL LIVE SMT -> FLOATING HTF RECONCILIATION
// Runs outside sweep blocks so reset/invalidation cannot leave stale HTF SMT.
// Only current live HTF candle is reconciled; confirmed older history is untouched.
// ==========================================================
if not na(c15_start_time)
    int live_sync_idx = get_htf_mark_index(c15_start_time)
    if live_sync_idx >= 0
        HTFMark live_sync_mk = array.get(htf_marks, live_sync_idx)
        bool live_bear_chart_smt = use_smt and allow_bear and is_bear_sweeping and not na(active_bear_b) and active_bear_smt_ok and close <= p15_h
        bool live_bull_chart_smt = use_smt and allow_bull and is_bull_sweeping and not na(active_bull_b) and active_bull_smt_ok and close >= p15_l
        if live_bear_chart_smt
            live_sync_mk.rsmt := true
            live_sync_mk.rsmt_bear := true
            live_sync_mk.rsmt_name := active_bear_smt_name
            live_sync_mk.rsmt_y1 := active_bear_smt_y1
            live_sync_mk.rsmt_y2 := active_bear_smt_y2
            live_sync_mk.rsmt_t1 := active_bear_smt_t1
            live_sync_mk.rsmt_t2 := active_bear_smt_t2
        else if live_bull_chart_smt
            live_sync_mk.rsmt := true
            live_sync_mk.rsmt_bear := false
            live_sync_mk.rsmt_name := active_bull_smt_name
            live_sync_mk.rsmt_y1 := active_bull_smt_y1
            live_sync_mk.rsmt_y2 := active_bull_smt_y2
            live_sync_mk.rsmt_t1 := active_bull_smt_t1
            live_sync_mk.rsmt_t2 := active_bull_smt_t2
        else
            live_sync_mk.rsmt := false
            live_sync_mk.rsmt_bear := false
            live_sync_mk.rsmt_name := ""
            live_sync_mk.rsmt_y1 := na
            live_sync_mk.rsmt_y2 := na
            live_sync_mk.rsmt_t1 := na
            live_sync_mk.rsmt_t2 := na
        array.set(htf_marks, live_sync_idx, live_sync_mk)

// CORE LOGIC 3: CISD ENGINE
// ==========================================

bool bull_manip_owner_valid = is_bull_sweeping or active_bull_cisd_owner != 0
bool bear_manip_owner_valid = is_bear_sweeping or active_bear_cisd_owner != 0

bool allow_bull_cisd_calc = allow_bull and use_cisd and bull_manip_owner_valid and active_bull_manip_id != 0
bool allow_bear_cisd_calc = allow_bear and use_cisd and bear_manip_owner_valid and active_bear_manip_id != 0

bool up_c = close >= open
bool dw_c = close <= open
bool eq_c = close == open

var float cur_htf_h = na
var float cur_htf_l = na
var float prev_htf_h = na
var float prev_htf_l = na

if is_new_15m
    prev_htf_h := cur_htf_h
    prev_htf_l := cur_htf_l
    cur_htf_h := high
    cur_htf_l := low
else
    cur_htf_h := math.max(nz(cur_htf_h, high), high)
    cur_htf_l := math.min(nz(cur_htf_l, low), low)


bool bull_owner_has_no_cisd = active_bull_manip_id != 0 and bull_cisd_done_owner != active_bull_manip_id

if allow_bull_cisd_calc and is_bull_sweeping and (bull_owner_has_no_cisd or bull_new_low_made)
    delete_cisd_for_manip(active_bull_manip_id) 
    bull_cisd_pending := true
    bull_reclaimed := false
    bull_cisd_done_owner := active_bull_manip_id

    if not na(active_bull_cisd_l)
        line.delete(active_bull_cisd_l)
        active_bull_cisd_l := na
    if not na(active_bull_cisd_lbl)
        label.delete(active_bull_cisd_lbl)
        active_bull_cisd_lbl := na

    bull_level_fixed := na
    bull_index_fixed := na

    if (dw_c or eq_c) and (up_c[1] or eq_c[1]) and not (eq_c and eq_c[1])
        bull_level_fixed := open
        bull_index_fixed := bar_index
    else
        for i = 2 to 10
            if low[i] < low
                break
            if (up_c[i] or eq_c[i]) and dw_c[i - 1]
                int bull_bar = i - 1
                bull_level_fixed := open[bull_bar]
                bull_index_fixed := bar_index - bull_bar
                for j = bull_bar to 0
                    if open[j] > bull_level_fixed and dw_c[j]
                        bull_level_fixed := open[j]
                        bull_index_fixed := bar_index - j
                break

    if na(bull_level_fixed)
        bull_level_fixed := dw_c ? open : high
        bull_index_fixed := bar_index

    if bull_level_fixed < open
        bull_level_fixed := dw_c ? open : high

    active_bull_cisd_l := line.new(
         bull_index_fixed, bull_level_fixed,
         bar_index, bull_level_fixed,
         width=cisd_line_width, color=col_pend, style=cisd_line_style)

    active_bull_cisd_lbl := label.new(
         bar_index + 0, bull_level_fixed,
         "+CISD",
         style=label.style_label_left,
         size=chart_text_size,
         textcolor=col_pend,
         color=color.new(color.white, 100))

    active_bull_cisd_owner := active_bull_manip_id

bool bear_owner_has_no_cisd = active_bear_manip_id != 0 and bear_cisd_done_owner != active_bear_manip_id

if allow_bear_cisd_calc and is_bear_sweeping and (bear_owner_has_no_cisd or bear_new_high_made)
    delete_cisd_for_manip(active_bear_manip_id) 
    bear_cisd_pending := true
    bear_reclaimed := false
    bear_cisd_done_owner := active_bear_manip_id

    if not na(active_bear_cisd_l)
        line.delete(active_bear_cisd_l)
        active_bear_cisd_l := na
    if not na(active_bear_cisd_lbl)
        label.delete(active_bear_cisd_lbl)
        active_bear_cisd_lbl := na

    bear_level_fixed := na
    bear_index_fixed := na

    if (up_c or eq_c) and (dw_c[1] or eq_c[1]) and not (eq_c and eq_c[1])
        bear_level_fixed := open
        bear_index_fixed := bar_index
    else
        for i = 2 to 10
            if high[i] > high
                break
            if (dw_c[i] or eq_c[i]) and up_c[i - 1]
                int bear_bar = i - 1
                bear_level_fixed := open[bear_bar]
                bear_index_fixed := bar_index - bear_bar
                for j = bear_bar to 0
                    if open[j] < bear_level_fixed and up_c[j]
                        bear_level_fixed := open[j]
                        bear_index_fixed := bar_index - j
                break

    if na(bear_level_fixed)
        bear_level_fixed := up_c ? open : low
        bear_index_fixed := bar_index

    if bear_level_fixed > open
        bear_level_fixed := up_c ? open : low

    active_bear_cisd_l := line.new(
         bear_index_fixed, bear_level_fixed,
         bar_index, bear_level_fixed,
         width=cisd_line_width, color=col_pend, style=cisd_line_style)

    active_bear_cisd_lbl := label.new(
         bar_index + 0, bear_level_fixed,
         "-CISD",
         style=label.style_label_left,
         size=chart_text_size,
         textcolor=col_pend,
         color=color.new(color.white, 100))

    active_bear_cisd_owner := active_bear_manip_id

bool bull_main_cisd_confirmed = false
bool bear_main_cisd_confirmed = false
if use_cisd and not is_new_15m
    bool xbull = not na(active_bull_cisd_l) and
         not na(bull_level_fixed) and
         bull_cisd_pending and
         bar_index > bull_index_fixed and
         close > bull_level_fixed

    if xbull
        bull_main_cisd_confirmed := true
        bull_reclaimed := true
        bull_cisd_pending := false

    bool xbear = not na(active_bear_cisd_l) and
         not na(bear_level_fixed) and
         bear_cisd_pending and
         bar_index > bear_index_fixed and
         close < bear_level_fixed

    if xbear
        bear_main_cisd_confirmed := true
        bear_reclaimed := true
        bear_cisd_pending := false

if not na(active_bull_cisd_l)
    line.set_x2(active_bull_cisd_l, bar_index)
    if bull_cisd_pending
        line.set_color(active_bull_cisd_l, col_pend)
        label.set_xy(active_bull_cisd_lbl, bar_index + 0, bull_level_fixed)
        label.set_text(active_bull_cisd_lbl, "+CISD")
        label.set_textcolor(active_bull_cisd_lbl, col_pend)
    else
        line.set_color(active_bull_cisd_l, col_bull_conf)
        label.set_xy(active_bull_cisd_lbl, bar_index + 0, bull_level_fixed)
        label.set_text(active_bull_cisd_lbl, "+CISD")
        label.set_textcolor(active_bull_cisd_lbl, col_bull_conf)

        add_cisd_history(plus_cisd_history, active_bull_cisd_l, active_bull_cisd_lbl, active_bull_cisd_owner, hist_plus_cisd)
        active_bull_cisd_l := na
        active_bull_cisd_lbl := na
        active_bull_cisd_owner := 0
        bull_cisd_pending := false

if not na(active_bear_cisd_l)
    line.set_x2(active_bear_cisd_l, bar_index)
    if bear_cisd_pending
        line.set_color(active_bear_cisd_l, col_pend)
        label.set_xy(active_bear_cisd_lbl, bar_index + 0, bear_level_fixed)
        label.set_text(active_bear_cisd_lbl, "-CISD")
        label.set_textcolor(active_bear_cisd_lbl, col_pend)
    else
        line.set_color(active_bear_cisd_l, col_bear_conf)
        label.set_xy(active_bear_cisd_lbl, bar_index + 0, bear_level_fixed)
        label.set_text(active_bear_cisd_lbl, "-CISD")
        label.set_textcolor(active_bear_cisd_lbl, col_bear_conf)

        add_cisd_history(minus_cisd_history, active_bear_cisd_l, active_bear_cisd_lbl, active_bear_cisd_owner, hist_minus_cisd)
        active_bear_cisd_l := na
        active_bear_cisd_lbl := na
        active_bear_cisd_owner := 0
        bear_cisd_pending := false

trim_cisd_history(plus_cisd_history, hist_plus_cisd)
trim_cisd_history(minus_cisd_history, hist_minus_cisd)

if use_cisd
    if array.size(plus_cisd_history) > 0
        for i = 0 to array.size(plus_cisd_history) - 1
            CISDHistory item = array.get(plus_cisd_history, i)
            if bar_index <= item.conf_bar + extend_cisd_bars
                line.set_x2(item.l, bar_index)
                label.set_x(item.lbl, bar_index + 0)

    if array.size(minus_cisd_history) > 0
        for i = 0 to array.size(minus_cisd_history) - 1
            CISDHistory item = array.get(minus_cisd_history, i)
            if bar_index <= item.conf_bar + extend_cisd_bars
                line.set_x2(item.l, bar_index)
                label.set_x(item.lbl, bar_index + 0)


// ==========================================
// ==========================================
// INTRACANDLE CISD (IC-CISD)
// Correct ownership model:
// - line X1 = first opposing candle of the delivery sequence that owns the protected extreme
// - line Y  = opening price of that delivery-origin candle
// - dot     = exact protected-high/protected-low candle
// - confirmation must occur after the protected candle by a confirmed body close
// ==========================================
type ICCISDDrawing
    line lvl
    label sig
    bool bull
    float protPrice
    int htfTime

var ICCISDDrawing[] icHist = array.new<ICCISDDrawing>()

// Running opposing delivery sequences inside the current HTF candle.
var bool icBearDelivery = false
var float icBearDeliveryOpen = na
var int icBearDeliveryX = na
var bool icBullDelivery = false
var float icBullDeliveryOpen = na
var int icBullDeliveryX = na

// Candidate bound to the latest protected extreme.
var bool icBullCandidate = false
var float icBullLvl = na
var int icBullLineX = na
var float icBullPL = na
var int icBullPLX = na
var bool icBullDone = false

var bool icBearCandidate = false
var float icBearLvl = na
var int icBearLineX = na
var float icBearPH = na
var int icBearPHX = na
var bool icBearDone = false

var ICCISDDrawing icActiveBull = na
var ICCISDDrawing icActiveBear = na

icDelete(ICCISDDrawing d) =>
    if not na(d)
        if not na(d.lvl)
            line.delete(d.lvl)
        if not na(d.sig)
            label.delete(d.sig)

icTrim() =>
    while array.size(icHist) > ic_cisd_history
        icDelete(array.shift(icHist))

if is_new_15m
    icActiveBull := na
    icActiveBear := na
    icBearDelivery := false
    icBearDeliveryOpen := na
    icBearDeliveryX := na
    icBullDelivery := false
    icBullDeliveryOpen := na
    icBullDeliveryX := na
    icBullCandidate := false
    icBullLvl := na
    icBullLineX := na
    icBullPL := na
    icBullPLX := na
    icBullDone := false
    icBearCandidate := false
    icBearLvl := na
    icBearLineX := na
    icBearPH := na
    icBearPHX := na
    icBearDone := false

if not use_ic_cisd
    while array.size(icHist) > 0
        icDelete(array.pop(icHist))
    icActiveBull := na
    icActiveBear := na

icLineStyle = ic_line_style_input == "Solid" ? line.style_solid : ic_line_style_input == "Dotted" ? line.style_dotted : line.style_dashed

if use_ic_cisd and not na(c15_open) and barstate.isconfirmed
    bool icDown = close < open
    bool icUp = close > open

    // Track the exact start of each contiguous bearish delivery.
    if icDown
        if not icBearDelivery
            icBearDelivery := true
            icBearDeliveryOpen := open
            icBearDeliveryX := bar_index
    else if icUp
        icBearDelivery := false

    // Track the exact start of each contiguous bullish delivery.
    if icUp
        if not icBullDelivery
            icBullDelivery := true
            icBullDeliveryOpen := open
            icBullDeliveryX := bar_index
    else if icDown
        icBullDelivery := false

    // BULLISH IC-CISD candidate.
    // A new protected low is accepted only while a valid bearish delivery exists.
    // Every lower protected low rebinds BOTH the line level and X1 to its owner delivery.
    if allow_bull and not icBullDone and low < c15_open and not na(icBearDeliveryOpen) and not na(icBearDeliveryX)
        bool newProtectedLow = na(icBullPL) or low < icBullPL
        if newProtectedLow
            icBullCandidate := true
            icBullPL := low
            icBullPLX := bar_index
            icBullLvl := icBearDeliveryOpen
            icBullLineX := icBearDeliveryX

    // Confirm only after the protected candle. This prevents the protected candle
    // itself or an unrelated older delivery from confirming the assembly.
    bool bullIC = allow_bull and not icBullDone and icBullCandidate and not na(icBullLvl) and not na(icBullLineX) and not na(icBullPLX) and bar_index > icBullPLX and close > icBullLvl
    if bullIC
        line ln = line.new(icBullLineX, icBullLvl, bar_index + ic_extend_bars, icBullLvl, xloc=xloc.bar_index, color=ic_bull_color, width=ic_line_width, style=icLineStyle)
        label lb = ic_show_dot ? label.new(icBullPLX, icBullPL, "●", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(ic_bull_color, 100), textcolor=ic_bull_color, size=ic_dot_size, textalign=text.align_center) : na
        ICCISDDrawing d = ICCISDDrawing.new(ln, lb, true, icBullPL, c15_start_time)
        array.push(icHist, d)
        icActiveBull := d
        icBullDone := true
        icTrim()

    // BEARISH IC-CISD candidate. Exact inverse of bullish ownership.
    if allow_bear and not icBearDone and high > c15_open and not na(icBullDeliveryOpen) and not na(icBullDeliveryX)
        bool newProtectedHigh = na(icBearPH) or high > icBearPH
        if newProtectedHigh
            icBearCandidate := true
            icBearPH := high
            icBearPHX := bar_index
            icBearLvl := icBullDeliveryOpen
            icBearLineX := icBullDeliveryX

    bool bearIC = allow_bear and not icBearDone and icBearCandidate and not na(icBearLvl) and not na(icBearLineX) and not na(icBearPHX) and bar_index > icBearPHX and close < icBearLvl
    if bearIC
        line ln = line.new(icBearLineX, icBearLvl, bar_index + ic_extend_bars, icBearLvl, xloc=xloc.bar_index, color=ic_bear_color, width=ic_line_width, style=icLineStyle)
        label lb = ic_show_dot ? label.new(icBearPHX, icBearPH, "●", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=ic_bear_color, size=ic_dot_size, textalign=text.align_center) : na
        ICCISDDrawing d = ICCISDDrawing.new(ln, lb, false, icBearPH, c15_start_time)
        array.push(icHist, d)
        icActiveBear := d
        icBearDone := true
        icTrim()

    // Confirmed body-close invalidation within the same HTF candle.
    if not na(icActiveBull) and close < icActiveBull.protPrice
        icDelete(icActiveBull)
        if array.size(icHist) > 0
            for n = array.size(icHist) - 1 to 0
                ICCISDDrawing d = array.get(icHist, n)
                if d.htfTime == icActiveBull.htfTime and d.bull
                    array.remove(icHist, n)
                    break
        icActiveBull := na

    if not na(icActiveBear) and close > icActiveBear.protPrice
        icDelete(icActiveBear)
        if array.size(icHist) > 0
            for n = array.size(icHist) - 1 to 0
                ICCISDDrawing d = array.get(icHist, n)
                if d.htfTime == icActiveBear.htfTime and not d.bull
                    array.remove(icHist, n)
                    break
        icActiveBear := na

icTrim()
// ==========================================
// DRAWING HTF UI (MOVED TO END FOR INSTANT UPDATES)
// ==========================================
if barstate.islast
    for b in htf_drawn_boxes
        box.delete(b)
    array.clear(htf_drawn_boxes)
    for l in htf_drawn_wicks
        line.delete(l)
    array.clear(htf_drawn_wicks)
    for lb in htf_drawn_labels
        label.delete(lb)
    array.clear(htf_drawn_labels)
    for hlb in htf_hover_labels
        label.delete(hlb)
    array.clear(htf_hover_labels)
    
    for vl in drawn_vseps
        line.delete(vl)
    array.clear(drawn_vseps)

    if use_vsep and array.size(vsep_indices) > 0
        for i = 0 to array.size(vsep_indices) - 1
            int idx = array.get(vsep_indices, i)
            line vl = line.new(x1=idx, y1=close, x2=idx, y2=close + syminfo.mintick, extend=extend.both, color=vsep_col, width=vsep_width, style=get_line_style(vsep_style))
            array.push(drawn_vseps, vl)

    if use_htf_candles
        HTFCandle[] all_candles = array.new<HTFCandle>()
        if array.size(htf_hist) > 0
            for i = 0 to array.size(htf_hist) - 1
                array.push(all_candles, array.get(htf_hist, i))
        if not na(cur_htf)
            array.push(all_candles, cur_htf)
            
        while array.size(all_candles) > htf_count
            array.shift(all_candles)
            
        int start_idx = bar_index + htf_offset
        for i = 0 to array.size(all_candles) - 1
            HTFCandle c = array.get(all_candles, i)
            
            int center_x = start_idx + (i * htf_spacing)
            int left_x = center_x - math.floor(htf_width / 2)
            int right_x = center_x + math.floor(htf_width / 2)
            
            bool is_bull_htf = c.c >= c.o
            color body_col = is_bull_htf ? col_htf_bull : col_htf_bear
            color border_col = is_bull_htf ? col_htf_bull_border : col_htf_bear_border
            
            float body_top = math.max(c.o, c.c)
            float body_bot = math.min(c.o, c.c)
            if body_top == body_bot
                body_top += syminfo.mintick * 0.5
                body_bot -= syminfo.mintick * 0.5
            
            box b = box.new(left_x, body_top, right_x, body_bot, border_color=border_col, border_width=htf_border_width, bgcolor=body_col)
            array.push(htf_drawn_boxes, b)

            // Floating HTF candle equilibrium: draw on EVERY displayed candle.
            // IMPORTANT: TradingView renders boxes above lines. Therefore a normal line can be
            // hidden by the HTF candle body. A zero-height box is created AFTER the candle body,
            // keeping the equilibrium marker visible on bullish, bearish and doji candles.
            // Current forming HTF candle par EQ hide
            bool is_current_htf_candle = i == array.size(all_candles) - 1

            if show_htf_eq_line and not is_current_htf_candle
                float htf_eq_price = math.avg(c.h, c.l)
                int htf_eq_x1 = left_x + 1
                int htf_eq_x2 = right_x + 3
                box htf_eq_b = box.new(left=htf_eq_x1, top=htf_eq_price, right=htf_eq_x2, bottom=htf_eq_price, xloc=xloc.bar_index, border_color=col_htf_eq_line, border_width=htf_eq_width, border_style=get_line_style(htf_eq_style_in), bgcolor=na)
                array.push(htf_drawn_boxes, htf_eq_b)
            
            // Connect the selected number of latest HTF opening prices from their
            // first LTF candles to the matching floating HTF candle bodies.
            if show_htf_open_connector and i >= math.max(0, array.size(all_candles) - htf_open_connector_count) and not na(c.start_bar)
                line open_connector = line.new(x1=c.start_bar, y1=c.o, x2=center_x, y2=c.o, xloc=xloc.bar_index, color=col_htf_open_connector, width=htf_open_connector_width, style=get_line_style(htf_open_connector_style))
                array.push(htf_drawn_wicks, open_connector)
            float upper_start = is_bull_htf ? c.c : c.o
            float lower_start = is_bull_htf ? c.o : c.c
            
            if c.h > upper_start
                line upper_wick = line.new(center_x, c.h, center_x, upper_start, color=col_htf_wick)
                array.push(htf_drawn_wicks, upper_wick)
            
            if lower_start > c.l
                line lower_wick = line.new(center_x, lower_start, center_x, c.l, color=col_htf_wick)
                array.push(htf_drawn_wicks, lower_wick)
            
            if i > 0
                for j = i - 1 to 0
                    HTFCandle prev_c = array.get(all_candles, j)
                    
                    bool h_swept = false
                    if i - j > 1
                        for k = j + 1 to i - 1
                            if array.get(all_candles, k).h > prev_c.h
                                h_swept := true
                                break
                    if not h_swept and c.h > prev_c.h
                        int prev_cx = start_idx + (j * htf_spacing)
                        line sweep_h_line = line.new(prev_cx, prev_c.h, center_x, prev_c.h, color=col_htf_sweep, width=1, style=line.style_solid)
                        array.push(htf_drawn_wicks, sweep_h_line)
                        
                    bool l_swept = false
                    if i - j > 1
                        for k = j + 1 to i - 1
                            if array.get(all_candles, k).l < prev_c.l
                                l_swept := true
                                break
                    if not l_swept and c.l < prev_c.l
                        int prev_cx = start_idx + (j * htf_spacing)
                        line sweep_l_line = line.new(prev_cx, prev_c.l, center_x, prev_c.l, color=col_htf_sweep, width=1, style=line.style_solid)
                        array.push(htf_drawn_wicks, sweep_l_line)
            
            int htf_sec_val = timeframe.in_seconds(active_htf_tf)
            string time_fmt = htf_sec_val >= 2419200 ? "MMM" : htf_sec_val >= 604800 ? "dd MMM" : htf_sec_val >= 86400 ? "EEE" : "hh:mm a"

            string t_str = str.format_time(c.t, time_fmt, syminfo.timezone)
            if show_htf_interval
                label lbl_t = label.new(center_x, c.l, text=t_str, style=label.style_label_up, color=color.new(color.white, 100), textcolor=col_htf_txt, size=size.tiny)
                array.push(htf_drawn_labels, lbl_t)
            
            // Render HTF Marks
            string mark_str = ""
            int candle_ms = timeframe.in_seconds(active_htf_tf) * 1000
            int mark_idx = get_htf_mark_index_for_candle(c.t, candle_ms)
            if mark_idx >= 0
                HTFMark mk = array.get(htf_marks, mark_idx)
                // Exclusive model role: C2 takes precedence if stale historical
                // state ever contains both flags during a live recalculation.
                // Floating HTF candles show only the generic confirmation text.
                // C1/C2 role and xC2 invalidation text remain exclusive to the LTF chart.
                bool htf_has_psp = mk.c1_psp or (mk.c2 and mk.psp) or mk.xc2_psp
                // Use exactly the same PSP state as the hover tooltip.
                // Stale role flags must never hide a valid PSP confirmation.
                if htf_has_psp
                    mark_str += "PSP"
                if mk.c3
                    mark_str += (mark_str == "" ? "" : "\n") + ""
                if mk.c4
                    mark_str += (mark_str == "" ? "" : "\n") + ""

                // Draw HTF SMT Lines Floating on HTF Panel
                if smt_history
                    if mk.rsmt 
                        int cx1 = na
                        int cx2 = na
                        for j = 0 to array.size(all_candles) - 1
                            if array.get(all_candles, j).t == mk.rsmt_t1
                                cx1 := start_idx + (j * htf_spacing)
                            if array.get(all_candles, j).t == mk.rsmt_t2
                                cx2 := start_idx + (j * htf_spacing)
                        if not na(cx1) and not na(cx2)
                            color smt_col = mk.rsmt_bear ? col_smt_bear : col_smt_bull
                            line smt_l = line.new(cx1, mk.rsmt_y1, cx2, mk.rsmt_y2, color=smt_col, width=smt_line_width, style=get_line_style(smt_line_style))
                            array.push(htf_drawn_wicks, smt_l)
                            if show_htf_smt_text
                                label smt_lbl = label.new(get_smt_lbl_x(cx1, cx2, smt_text_align), math.avg(mk.rsmt_y1, mk.rsmt_y2), text=mk.rsmt_name, style=label.style_none, textcolor=smt_text_color, size=get_text_size(smt_text_size), textalign=text.align_center)
                                array.push(htf_drawn_labels, smt_lbl)
                            
                    if mk.ssmt 
                        int cx1 = na
                        int cx2 = na
                        for j = 0 to array.size(all_candles) - 1
                            if array.get(all_candles, j).t == mk.ssmt_t1
                                cx1 := start_idx + (j * htf_spacing)
                            if array.get(all_candles, j).t == mk.ssmt_t2
                                cx2 := start_idx + (j * htf_spacing)
                        if not na(cx1) and not na(cx2)
                            color smt_col = mk.ssmt_bear ? col_smt_bear : col_smt_bull
                            line smt_l = line.new(cx1, mk.ssmt_y1, cx2, mk.ssmt_y2, color=smt_col, width=smt_line_width, style=get_line_style(smt_line_style))
                            array.push(htf_drawn_wicks, smt_l)
                            if show_htf_smt_text
                                label smt_lbl = label.new(get_smt_lbl_x(cx1, cx2, smt_text_align), math.avg(mk.ssmt_y1, mk.ssmt_y2), text=mk.ssmt_name, style=label.style_none, textcolor=smt_text_color, size=get_text_size(smt_text_size), textalign=text.align_center)
                                array.push(htf_drawn_labels, smt_lbl)

            // Hover tooltip contains PSP and SMT information only.
            if show_htf_hover_tooltip
                string hover_psp = "None"
                string hover_smt = "None"
                if mark_idx >= 0
                    HTFMark hover_mk = array.get(htf_marks, mark_idx)
                    bool hover_has_psp = hover_mk.c1_psp or (hover_mk.c2 and hover_mk.psp) or hover_mk.xc2_psp
                    hover_psp := hover_has_psp and hover_mk.psp_name != "" ? hover_mk.psp_name : hover_has_psp ? "Confirmed" : "None"
                    hover_smt := hover_mk.rsmt and hover_mk.ssmt ? hover_mk.rsmt_name + " / " + hover_mk.ssmt_name : hover_mk.rsmt ? hover_mk.rsmt_name : hover_mk.ssmt ? hover_mk.ssmt_name : "None"
                string hover_tip = "PSP: " + hover_psp + "\n" + "SMT: " + hover_smt
                // Pine tooltips belong to labels, not to candle boxes or wick lines.
                // Multiple invisible large labels cover the full high-to-low candle span,
                // so hovering the body, upper wick, lower wick, high or low shows the same tooltip.
                float hover_body_mid = math.avg(body_top, body_bot)
                float hover_upper_mid = math.avg(c.h, body_top)
                float hover_lower_mid = math.avg(body_bot, c.l)
                float hover_full_q1 = c.l + (c.h - c.l) * 0.25
                float hover_full_q3 = c.l + (c.h - c.l) * 0.75
                float[] hover_points = array.from(c.h, hover_upper_mid, hover_full_q3, body_top, hover_body_mid, body_bot, hover_full_q1, hover_lower_mid, c.l)
                for hover_i = 0 to array.size(hover_points) - 1
                    float hover_y = array.get(hover_points, hover_i)
                    label hover_lbl = label.new(center_x, hover_y, text="●", style=label.style_none, color=color.new(color.white, 100), textcolor=color.new(color.white, 100), size=size.large, textalign=text.align_center, tooltip=hover_tip)
                    array.push(htf_hover_labels, hover_lbl)

            // Keep C2/C3/C4/PSP marks attached to their own HTF candle.
            if mark_str != ""
                float mark_pad = math.max((c.h - c.l) * 0.03, syminfo.mintick * 5)
                HTFMark position_mk = array.get(htf_marks, mark_idx)
                float mark_y = position_mk.psp_above ? c.h + mark_pad : c.l - mark_pad
                label lbl_mark = label.new(center_x, mark_y, text=mark_str, style=label.style_none, color=color.new(color.white, 100), textcolor=col_htf_mark_txt, size=chart_text_size, textalign=text.align_center)
                array.push(htf_drawn_labels, lbl_mark)

        // LIVE HTF TIMER: centred on the complete floating candle group.
        int candle_total = array.size(all_candles)
        if candle_total > 0
            HTFCandle live_candle = array.get(all_candles, candle_total - 1)
            int first_group_x = start_idx
            int last_group_x = start_idx + ((candle_total - 1) * htf_spacing)
            int group_center_x = int(math.round(math.avg(first_group_x, last_group_x)))

            float group_high = array.get(all_candles, 0).h
            float group_low = array.get(all_candles, 0).l
            if candle_total > 1
                for gi = 1 to candle_total - 1
                    HTFCandle gc = array.get(all_candles, gi)
                    group_high := math.max(group_high, gc.h)
                    group_low := math.min(group_low, gc.l)

            int timer_htf_sec = timeframe.in_seconds(active_htf_tf)
            int timer_end_time = live_candle.t + (timer_htf_sec * 1000)
            int timer_remaining = math.max(0, timer_end_time - timenow)
            int timer_hrs = int(math.floor(timer_remaining / 3600000))
            int timer_mins = int(math.floor((timer_remaining % 3600000) / 60000))
            int timer_secs = int(math.floor((timer_remaining % 60000) / 1000))
            string timer_value = str.tostring(timer_hrs, "00") + ":" + str.tostring(timer_mins, "00") + ":" + str.tostring(timer_secs, "00")
            string timer_text = get_tf_display_name(active_htf_tf) + "\n" + timer_value + ""
            timer_label_size = get_timer_size(htf_timer_size)

            if htf_timer_position == "Top" or htf_timer_position == "Both"
                label timer_top = label.new(group_center_x, group_high, text=timer_text, style=label.style_label_down, color=color.new(color.white, 100), textcolor=col_htf_txt, size=timer_label_size, textalign=text.align_center)
                array.push(htf_drawn_labels, timer_top)

            if htf_timer_position == "Bottom" or htf_timer_position == "Both"
                label timer_bottom = label.new(group_center_x, group_low, text=timer_text, style=label.style_label_up, color=color.new(color.white, 100), textcolor=col_htf_txt, size=timer_label_size, textalign=text.align_center)
                array.push(htf_drawn_labels, timer_bottom)
