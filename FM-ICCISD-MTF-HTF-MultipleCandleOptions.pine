ic_line_width = input.int(2, "Width", minval=1, maxval=5, inline="icc1", group=grp_cisd)
ic_line_style_input = input.string("Dashed", "Style", options=["Solid", "Dashed", "Dotted"], inline="icc1", group=grp_cisd)
ic_extend_bars = input.int(5, "Extend", minval=0, maxval=100, inline="icc2", group=grp_cisd)
ic_bull_color = input.color(color.new(#2962ff, 0), "+IC", inline="icc2", group=grp_cisd)
ic_bear_color = input.color(color.new(#f23645, 0), "-IC", inline="icc2", group=grp_cisd)

// Resolved after declarations to avoid undeclared-identifier compile errors.
ic_dot_size = ic_dot_size_input == "Tiny" ? size.tiny : ic_dot_size_input == "Normal" ? size.normal : ic_dot_size_input == "Large" ? size.large : ic_dot_size_input == "Huge" ? size.huge : size.small
cisd_line_style = cisd_line_style_input == "Dashed" ? line.style_dashed : cisd_line_style_input == "Dotted" ? line.style_dotted : line.style_solid

use_htf_candles = input.bool(true, "HTF ON/OFF", inline="htf0", group=grp_htf_main)
show_htf_hover_tooltip = input.bool(true, "Hover Info", inline="htf0", group=grp_htf_main, tooltip="Hover over a floating HTF candle to view PSP and SMT information only.")
htf_mode        = input.string("Automatic", "Alignment", options=["Automatic", "Custom", "1s-1m", "15s-5m", "1m-15m", "3m-30m", "5m-1H", "15m-4H", "1H-1D", "4H-1W", "1D-1M", "1W-3M", "1M-12M"], inline="htf0", group=grp_htf_main)
htf_manual_tf   = input.timeframe("15", "Custom TF", inline="htf0", group=grp_htf_main)
htf_count       = input.int(4, "Count", minval=1, maxval=20, inline="htf1", group=grp_htf_main, tooltip="Controls only how many floating HTF candles are displayed.")
htf_offset      = input.int(30, "Offset", minval=1, inline="htf1", group=grp_htf_main)
htf_width       = input.int(3, "Width", minval=1, inline="htf1", group=grp_htf_main)
htf_spacing     = input.int(3, "Spacing", minval=1, inline="htf1", group=grp_htf_main)
col_htf_bull    = input.color(color.new(#ffffff, 0), "Bull Body", inline="htf2", group=grp_htf_main)
col_htf_bear    = input.color(color.new(#000000, 0), "Bear Body", inline="htf2", group=grp_htf_main)
col_htf_bull_border = input.color(#000000, "Bull Border", inline="htf3", group=grp_htf_main)
col_htf_bear_border = input.color(#000000, "Bear Border", inline="htf3", group=grp_htf_main)
htf_border_width = input.int(1, "Border", minval=1, maxval=5, inline="htf3", group=grp_htf_main)
col_htf_wick    = input.color(color.new(color.gray, 0), "Wick", inline="htf4", group=grp_htf_main)
show_htf_eq_line = input.bool(true, "HTF EQ ON/OFF", inline="htfeq", group=grp_htf_eq, tooltip="Shows the 50% equilibrium line across each floating HTF candle.")
col_htf_eq_line  = input.color(color.new(#000000, 90), "Color", inline="htfeq", group=grp_htf_eq)
htf_eq_width     = input.int(1, "Width", minval=1, maxval=10, inline="htfeq2", group=grp_htf_eq)
htf_eq_style_in  = input.string("Dashed", "Style", options=["Solid", "Dashed", "Dotted"], inline="htfeq2", group=grp_htf_eq)
col_htf_txt     = input.color(color.new(color.black, 0), "Time Text", inline="htf4", group=grp_htf_timer)
show_htf_open_connector = input.bool(true, "HTF Open Connector", inline="htf_open", group=grp_htf_open, tooltip="Connects the selected number of latest floating HTF candle opens to their first LTF candles.")
