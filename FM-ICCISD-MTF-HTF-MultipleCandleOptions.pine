// ==========================================
// FRACTAL TIME MATCHING ENGINE
// ==========================================
get_auto_htf() =>
    switch timeframe.period
        "1" => "15"
        "3" => "30"
        "5" => "60"
        "15" => "240"
        "30" => "240"
        "60" => "1D"
        "120" => "1D"
        "240" => "1W"
        "1D" => "1M"
        "1W" => "3M"
        "1M" => "12M"
        "1S" => "1"
        "15S" => "5"
        => ""

get_fractal_htf() =>
    switch htf_mode
        "Automatic" => get_auto_htf()
        "Custom" => htf_manual_tf
        "1s-1m" => "1"
        "15s-5m" => "5"
        "1m-15m" => "15"
        "3m-30m" => "30"
        "5m-1H" => "60"
        "15m-4H" => "240"
        "1H-1D" => "1D"
        "4H-1W" => "1W"
        "1D-1M" => "1M"
        "1W-3M" => "3M"
        "1M-12M" => "12M"
        => get_auto_htf()

string active_htf_tf = get_fractal_htf()
bool is_new_htf_tf = active_htf_tf != "" ? timeframe.change(active_htf_tf) : false

int chart_seconds = timeframe.in_seconds()
int htf_seconds   = timeframe.in_seconds(active_htf_tf)
int default_bar_count = math.max(1, int(math.round(htf_seconds / chart_seconds)))

var int bars_in_htf = default_bar_count
var int bar_count_temp = 0

if is_new_htf_tf
    if bar_count_temp > 0
        bars_in_htf := bar_count_temp
    bar_count_temp := 1
else
    bar_count_temp += 1

int matched_bar_count = bars_in_htf

var int[] vsep_indices = array.new_int()
if is_new_htf_tf
    array.push(vsep_indices, bar_index)
    if array.size(vsep_indices) > htf_count
        array.shift(vsep_indices)

get_tf_display_name(string tf) =>
    int sec = timeframe.in_seconds(tf)
    if sec >= 2419200
        int m = math.round(sec / 2592000)
        (m > 1 ? str.tostring(m) : "1") + "M"
    else if sec >= 604800
        int w = math.round(sec / 604800)
        (w > 1 ? str.tostring(w) : "1") + "W"
    else if sec >= 86400
        int d = math.round(sec / 86400)
        (d > 1 ? str.tostring(d) : "1") + "D"
    else if sec >= 3600
        int h = math.round(sec / 3600)
        str.tostring(h) + "H"
    else
        int min = math.round(sec / 60)
        str.tostring(min) + "m"

type HTFCandle
    float o
    float h
    float l
    float c
    int t
    int start_bar

type HTFMark
    int t
    bool c2
    bool psp
    bool c1_psp
    string psp_name
    bool psp_above
    bool xc2
    bool xc2_psp
    bool c3
    bool c4
    bool rsmt
    bool rsmt_bear
    string rsmt_name
    float rsmt_y1
    float rsmt_y2
    int rsmt_t1
    int rsmt_t2
    bool ssmt
    bool ssmt_bear
    string ssmt_name
    float ssmt_y1
    float ssmt_y2
    int ssmt_t1
    int ssmt_t2

type ManipDrawings
    box b
    line l
    label lbl
    box dist_b
    label dist_lbl
    line dist_eq_l
    box cont_b
    label cont_lbl
    line cont_eq_l
    int id
    line smt_l 
    label smt_lbl
    float def_line 
    int c2_time
    bool c2_psp
    int c3_time
    int c4_time

type CISDHistory
    line l
    label lbl
    int owner_id
    int conf_bar 


type OBHistory
    line l
    label lbl
    int owner_id
    bool bullish

type SMT_Tracker
    float h
    float l
    int h_idx
    int l_idx
    int h_t
    int l_t
    float prev_h
    float prev_l
    int prev_h_idx
    int prev_l_idx
    int prev_h_t
    int prev_l_t

// ==========================================================
// SMT CORRELATION ENGINE
// ==========================================================
string invalid_symbol = "INVALID:INVALID"
acl_config = resolveCurrentChart()
string smt_sym1_resolved = smt_ticker_in == "" ? acl_config.secondary : smt_ticker_in
string smt_sym2_resolved = smt_ticker2_in == "" ? acl_config.tertiary : smt_ticker2_in
bool smt_sym1_inverse = smt_ticker_in == "" ? (smt_inverse1 != acl_config.invertSecondary) : smt_inverse1
bool smt_sym2_inverse = smt_ticker2_in == "" ? (smt_inverse2 != acl_config.invertTertiary) : smt_inverse2
[smt_sym1_h, smt_sym1_l] = request.security(smt_sym1_resolved, timeframe.period, [high, low], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[smt_sym2_h, smt_sym2_l] = request.security(smt_sym2_resolved, timeframe.period, [high, low], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

string corr_ticker1 = not na(smt_sym1_h) and not na(smt_sym1_l) ? smt_sym1_resolved : invalid_symbol
string corr_ticker2 = not na(smt_sym2_h) and not na(smt_sym2_l) ? smt_sym2_resolved : invalid_symbol

get_smt_display_name(string ticker) =>
    int sep = str.pos(ticker, ":")
    sep >= 0 ? str.substring(ticker, sep + 1) : ticker

string smt_sym1_ticker = corr_ticker1 != invalid_symbol ? get_smt_display_name(corr_ticker1) : ""
string smt_sym2_ticker = corr_ticker2 != invalid_symbol ? get_smt_display_name(corr_ticker2) : ""

var SMT_Tracker smt_tracker_curr = SMT_Tracker.new()
var SMT_Tracker smt_tracker1 = SMT_Tracker.new()
var SMT_Tracker smt_tracker2 = SMT_Tracker.new()

// ==========================================================
// HTF MARK MIRROR ENGINE
// ==========================================================
var HTFMark[] htf_marks = array.new<HTFMark>()
// Main-chart C1 PSP labels. Labels are anchored to the centre of the actual
// C1 HTF interval and retained with the same compact history policy.
var label[] c1_psp_chart_labels = array.new_label()
var int[] c1_psp_chart_times = array.new_int()
// Unified xC2 storage declarations are placed here so C1 PSP rendering can check ownership.
var label[] bull_xc2_history = array.new_label()
var int[] bull_xc2_times = array.new_int()
var label[] bear_xc2_history = array.new_label()
var int[] bear_xc2_times = array.new_int()

has_ltf_xc2_at_time(int target_time) =>
    bool found = false
    if array.size(bear_xc2_times) > 0
        for xi = 0 to array.size(bear_xc2_times) - 1
            if array.get(bear_xc2_times, xi) == target_time
                found := true
                break
    if not found and array.size(bull_xc2_times) > 0
        for xi = 0 to array.size(bull_xc2_times) - 1
            if array.get(bull_xc2_times, xi) == target_time
                found := true
                break
    found
store_c1_psp_chart_label(int c1_time, float c1_high, float c1_low, bool c1_bullish) =>
    bool xc2_owns_candle = has_ltf_xc2_at_time(c1_time)
    bool already_drawn = false
    if array.size(c1_psp_chart_times) > 0
        for pi = 0 to array.size(c1_psp_chart_times) - 1
            if array.get(c1_psp_chart_times, pi) == c1_time
                already_drawn := true
                break
    if not already_drawn and not xc2_owns_candle
        // FIX: use absolute HTF time anchoring instead of conditional ta.valuewhen().
        // The old lookup could return na when this function was called only on C2
        // confirmation, so the HTF panel had PSP state but no LTF chart label.
        int c1_center_time = c1_time + int(math.round(timeframe.in_seconds(active_htf_tf) * 1000.0 / 2.0))
        float c1_pad = math.max((c1_high - c1_low) * 0.03, syminfo.mintick * 5)
        float c1_y = c1_bullish ? c1_low - c1_pad : c1_high + c1_pad
        label c1_lb = label.new(x=c1_center_time, y=c1_y, xloc=xloc.bar_time, text="PSP", style=label.style_none, textcolor=manip_txt_col, size=chart_text_size, textalign=text.align_center)
        array.push(c1_psp_chart_labels, c1_lb)
        array.push(c1_psp_chart_times, c1_time)
        int max_c1_psp_labels = math.max(2, bull_history + bear_history)
        while array.size(c1_psp_chart_labels) > max_c1_psp_labels
            label.delete(array.shift(c1_psp_chart_labels))
            array.shift(c1_psp_chart_times)

delete_c1_psp_chart_label(int target_time) =>
    if array.size(c1_psp_chart_times) > 0
        for pi = array.size(c1_psp_chart_times) - 1 to 0
            if array.get(c1_psp_chart_times, pi) == target_time
                label.delete(array.get(c1_psp_chart_labels, pi))
                array.remove(c1_psp_chart_labels, pi)
                array.remove(c1_psp_chart_times, pi)

get_htf_mark_index(int mark_time) =>
    int found = -1
    if array.size(htf_marks) > 0
        for mi = 0 to array.size(htf_marks) - 1
            HTFMark hm = array.get(htf_marks, mi)
            if hm.t == mark_time
                found := mi
                break
    found

// Robust lookup for floating HTF candles. It first uses an exact timestamp,
// then accepts any stored mark falling inside that HTF candle's time window.
get_htf_mark_index_for_candle(int candle_time, int candle_ms) =>
    int found = get_htf_mark_index(candle_time)
    if found == -1 and array.size(htf_marks) > 0
        int candle_end = candle_time + candle_ms
        for mi = array.size(htf_marks) - 1 to 0
            HTFMark hm = array.get(htf_marks, mi)
            if hm.t >= candle_time and hm.t < candle_end
                found := mi
                break
    found

ensure_htf_mark(int mark_time) =>
    int idx = get_htf_mark_index(mark_time)
    if idx == -1
        array.push(htf_marks, HTFMark.new(t=mark_time, c2=false, psp=false, c1_psp=false, psp_name="", psp_above=false, xc2=false, xc2_psp=false, c3=false, c4=false, rsmt=false, rsmt_bear=false, rsmt_name="", rsmt_y1=na, rsmt_y2=na, rsmt_t1=na, rsmt_t2=na, ssmt=false, ssmt_bear=false, ssmt_name="", ssmt_y1=na, ssmt_y2=na, ssmt_t1=na, ssmt_t2=na))
        idx := array.size(htf_marks) - 1
    idx

trim_htf_marks() =>
    int keep = math.max(20, htf_history_count * 6)
    while array.size(htf_marks) > keep
        array.shift(htf_marks)

var int c15_start_time = na

var OBHistory[] bull_ob_history = array.new<OBHistory>()
var OBHistory[] bear_ob_history = array.new<OBHistory>()

trim_ob_history(OBHistory[] arr, int max_count) =>
    while array.size(arr) > max_count
        OBHistory old = array.shift(arr)
        line.delete(old.l)
        if not na(old.lbl)
            label.delete(old.lbl)

delete_ob_for_manip(int target_id) =>
    if target_id != 0
        if array.size(bull_ob_history) > 0
            for i = array.size(bull_ob_history) - 1 to 0
                OBHistory item = array.get(bull_ob_history, i)
                if item.owner_id == target_id
                    line.delete(item.l)
                    if not na(item.lbl)
                        label.delete(item.lbl)
                    array.remove(bull_ob_history, i)
        if array.size(bear_ob_history) > 0
            for i = array.size(bear_ob_history) - 1 to 0
                OBHistory item = array.get(bear_ob_history, i)
                if item.owner_id == target_id
                    line.delete(item.l)
                    if not na(item.lbl)
                        label.delete(item.lbl)
                    array.remove(bear_ob_history, i)

var CISDHistory[] plus_cisd_history = array.new<CISDHistory>()
var CISDHistory[] minus_cisd_history = array.new<CISDHistory>()

trim_cisd_history(CISDHistory[] arr, int max_count) =>
    while array.size(arr) > max_count
        CISDHistory old = array.shift(arr)
        line.delete(old.l)
        label.delete(old.lbl)

add_cisd_history(CISDHistory[] arr, line ln, label lb, int owner_id, int max_count) =>
    if max_count > 0
        array.push(arr, CISDHistory.new(ln, lb, owner_id, bar_index)) 
        trim_cisd_history(arr, max_count)
    else
        line.delete(ln)
        label.delete(lb)

delete_cisd_for_manip(int target_id) =>
    if target_id != 0
        if array.size(plus_cisd_history) > 0
            for i = array.size(plus_cisd_history) - 1 to 0
                CISDHistory item = array.get(plus_cisd_history, i)
                if item.owner_id == target_id
                    line.delete(item.l)
                    label.delete(item.lbl)
                    array.remove(plus_cisd_history, i)
        if array.size(minus_cisd_history) > 0
            for i = array.size(minus_cisd_history) - 1 to 0
                CISDHistory item = array.get(minus_cisd_history, i)
                if item.owner_id == target_id
                    line.delete(item.l)
                    label.delete(item.lbl)
                    array.remove(minus_cisd_history, i)

get_line_style(s) => s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted
get_text_size(s) => s == "Tiny" ? size.tiny : s == "Small" ? size.normal : s == "Normal" ? size.normal : size.large

// ==========================================================
// STANDARD DEVIATION PROJECTION ENGINE
// 1 = confirmed C2 extreme
// 0 = latest opposite structure swing before the C2 extreme
// negative values = projections beyond level 0
// ==========================================================
var line[] sd_projection_lines = array.new_line()
var label[] sd_projection_labels = array.new_label()
var int[] sd_projection_owner_ids = array.new_int()

sd_projection_label_size = sd_projection_label_size_in == "Tiny" ? size.tiny : sd_projection_label_size_in == "Small" ? size.small : sd_projection_label_size_in == "Large" ? size.large : size.normal

delete_sd_projection_for_owner(int target_id) =>
    if target_id != 0 and array.size(sd_projection_owner_ids) > 0
        for si = array.size(sd_projection_owner_ids) - 1 to 0
            if array.get(sd_projection_owner_ids, si) == target_id
                line.delete(array.get(sd_projection_lines, si))
                label sd_old_label = array.get(sd_projection_labels, si)
                if not na(sd_old_label)
                    label.delete(sd_old_label)
                array.remove(sd_projection_lines, si)
                array.remove(sd_projection_labels, si)
                array.remove(sd_projection_owner_ids, si)

trim_sd_projection_history() =>
    int level_count = math.max(1, array.size(str.split(sd_projection_levels, ",")))
    int max_objects = math.max(level_count, (bull_history + bear_history) * level_count)
    while array.size(sd_projection_lines) > max_objects
        line.delete(array.shift(sd_projection_lines))
        label sd_old_label = array.shift(sd_projection_labels)
        if not na(sd_old_label)
            label.delete(sd_old_label)
        array.shift(sd_projection_owner_ids)

f_sd_structure_anchor(bool bearish, int c2_start_t, int c2_end_t, float c2_extreme) =>
    float structure_anchor = na
    int structure_time = na
    int extreme_time = na
    int htf_ms_local = timeframe.in_seconds(active_htf_tf) * 1000
    int search_start_t = c2_start_t - htf_ms_local
    for k = 0 to 5000
        int kt = time[k]
        if na(kt)
            break
        if kt < c2_start_t
            break
        if kt >= c2_start_t and kt < c2_end_t
            bool is_extreme_bar = bearish ? high[k] >= c2_extreme : low[k] <= c2_extreme
            if is_extreme_bar
                extreme_time := kt
                break
    if not na(extreme_time)
        for k = 1 to 4999
            int kt = time[k]
            if na(kt) or na(time[k + 1]) or na(time[k - 1])
                break
            if kt < search_start_t
                break
            if kt >= search_start_t and kt < extreme_time
                bool swing_low = low[k] < low[k + 1] and low[k] < low[k - 1]
                bool swing_high = high[k] > high[k + 1] and high[k] > high[k - 1]
                if bearish and swing_low
                    structure_anchor := low[k]
                    structure_time := kt
                    break
                if not bearish and swing_high
                    structure_anchor := high[k]
                    structure_time := kt
                    break
    [structure_anchor, structure_time, extreme_time]

f_draw_sd_projection(bool bearish, int c2_start_t, int c2_end_t, float c2_extreme, int owner_id) =>
    if show_sd_projection and owner_id != 0 and not na(c2_extreme)
        [structure_anchor, structure_time, extreme_time] = f_sd_structure_anchor(bearish, c2_start_t, c2_end_t, c2_extreme)
        if not na(structure_anchor) and not na(structure_time) and not na(extreme_time)
            delete_sd_projection_for_owner(owner_id)
            float projection_range = math.abs(c2_extreme - structure_anchor)
            int marker_x1 = math.min(structure_time, extreme_time)
            int marker_x2 = math.max(structure_time, extreme_time)
            if marker_x1 == marker_x2
                marker_x2 += timeframe.in_seconds() * 1000
            string[] level_parts = str.split(sd_projection_levels, ",")
            if array.size(level_parts) > 0
                for pi = 0 to array.size(level_parts) - 1
                    string raw_level = str.trim(array.get(level_parts, pi))
                    float level_value = str.tonumber(raw_level)
                    if not na(level_value)
                        float level_price = level_value == 1 ? c2_extreme : level_value == 0 ? structure_anchor : bearish ? structure_anchor - projection_range * math.abs(level_value) : structure_anchor + projection_range * math.abs(level_value)
                        line projection_line = line.new(marker_x1, level_price, marker_x2, level_price, xloc=xloc.bar_time, color=sd_projection_color, width=sd_projection_width, style=get_line_style(sd_projection_style_in))
                        label projection_label = show_sd_projection_labels ? label.new(marker_x1, level_price, raw_level, xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.black, 100), textcolor=sd_projection_color, textalign=text.align_right, size=sd_projection_label_size) : na
                        array.push(sd_projection_lines, projection_line)
                        array.push(sd_projection_labels, projection_label)
                        array.push(sd_projection_owner_ids, owner_id)
            trim_sd_projection_history()
get_timer_size(s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : size.large
get_smt_lbl_x(x1, x2, align) => align == "Left" ? x1 : align == "Center" ? int(math.round(math.avg(x1, x2))) : x2

CheckSMTDivergence(bool is_bearish, SMT_Tracker tracker_curr,
                   SMT_Tracker tracker1, SMT_Tracker tracker2,
                   bool sym1_enabled, bool sym2_enabled,
                   bool sym1_inverse, bool sym2_inverse,
                   string sym1_ticker, string sym2_ticker) =>
    bool has_smt = false
    int x1 = na
    int x2 = na
    float y1 = na
    float y2 = na
    int t1 = na
    int t2 = na
    string smt_sym = ""
    bool sym1_triggered = false
    bool sym2_triggered = false

    bool curr_hh = not na(tracker_curr.prev_h) and tracker_curr.h > tracker_curr.prev_h
    bool curr_ll = not na(tracker_curr.prev_l) and tracker_curr.l < tracker_curr.prev_l
    bool curr_lh = not na(tracker_curr.prev_h) and tracker_curr.h < tracker_curr.prev_h
    bool curr_hl = not na(tracker_curr.prev_l) and tracker_curr.l > tracker_curr.prev_l

    if sym1_enabled and not na(tracker1.prev_h) and not na(tracker1.h)
        bool comp_hh = tracker1.h > tracker1.prev_h
        bool comp_ll = not na(tracker1.prev_l) and tracker1.l < tracker1.prev_l
        bool comp_lh = tracker1.h < tracker1.prev_h
        bool comp_hl = not na(tracker1.prev_l) and tracker1.l > tracker1.prev_l
        if is_bearish
            bool curr_leads = sym1_inverse ? (curr_hh and comp_hl) : (curr_hh and comp_lh)
            bool comp_leads = sym1_inverse ? (comp_ll and curr_lh) : (comp_hh and curr_lh)
            sym1_triggered := curr_leads or comp_leads
        else
            bool curr_leads = sym1_inverse ? (curr_ll and comp_lh) : (curr_ll and comp_hl)
            bool comp_leads = sym1_inverse ? (comp_hh and curr_hl) : (comp_ll and curr_hl)
            sym1_triggered := curr_leads or comp_leads

    if sym2_enabled and not na(tracker2.prev_h) and not na(tracker2.h)
        bool comp_hh = tracker2.h > tracker2.prev_h
        bool comp_ll = not na(tracker2.prev_l) and tracker2.l < tracker2.prev_l
        bool comp_lh = tracker2.h < tracker2.prev_h
        bool comp_hl = not na(tracker2.prev_l) and tracker2.l > tracker2.prev_l
        if is_bearish
            bool curr_leads = sym2_inverse ? (curr_hh and comp_hl) : (curr_hh and comp_lh)
            bool comp_leads = sym2_inverse ? (comp_ll and curr_lh) : (comp_hh and curr_lh)
            sym2_triggered := curr_leads or comp_leads
        else
            bool curr_leads = sym2_inverse ? (curr_ll and comp_lh) : (curr_ll and comp_hl)
            bool comp_leads = sym2_inverse ? (comp_hh and curr_hl) : (comp_ll and curr_hl)
            sym2_triggered := comp_leads or curr_leads

    if sym1_triggered or sym2_triggered
        has_smt := true
        if is_bearish
            x1 := tracker_curr.prev_h_idx
            x2 := tracker_curr.h_idx
            y1 := tracker_curr.prev_h
            y2 := tracker_curr.h
            t1 := tracker_curr.prev_h_t
            t2 := tracker_curr.h_t
        else
            x1 := tracker_curr.prev_l_idx
            x2 := tracker_curr.l_idx
            y1 := tracker_curr.prev_l
            y2 := tracker_curr.l
            t1 := tracker_curr.prev_l_t
            t2 := tracker_curr.l_t
        smt_sym := sym1_triggered and sym2_triggered ? sym1_ticker + "/" + sym2_ticker : sym1_triggered ? sym1_ticker : sym2_ticker

    [has_smt, x1, x2, y1, y2, t1, t2, smt_sym]

// ==========================================
// CORE LOGIC 1: HTF CANDLES EXECUTION
// ==========================================
var HTFCandle[] htf_hist = array.new<HTFCandle>()
var HTFCandle cur_htf = na

if use_htf_candles
    if is_new_htf_tf or na(cur_htf)
        if not na(cur_htf)
            array.push(htf_hist, HTFCandle.new(cur_htf.o, cur_htf.h, cur_htf.l, cur_htf.c, cur_htf.t, cur_htf.start_bar))
            // Candle display storage is independent from model History.
            // Preserve the maximum display capacity and slice by htf_count at render time.
            if array.size(htf_hist) > 19
                array.shift(htf_hist)
        cur_htf := HTFCandle.new(open, high, low, close, nz(time(active_htf_tf), time), bar_index)
    else
        cur_htf.h := math.max(cur_htf.h, high)
        cur_htf.l := math.min(cur_htf.l, low)
        cur_htf.c := close

var box[] htf_drawn_boxes = array.new_box()
var line[] htf_drawn_wicks = array.new_line()
var label[] htf_drawn_labels = array.new_label()
var label[] htf_hover_labels = array.new_label()
var line[] drawn_vseps = array.new_line()

// ==========================================
// CORE LOGIC 2: AMD FRACTAL MANIPULATION ENGINE
// ==========================================
bool bear_new_high_made = false
bool bull_new_low_made = false

var ManipDrawings[] bull_manips = array.new<ManipDrawings>()
var ManipDrawings[] bear_manips = array.new<ManipDrawings>()
var line[] quartile_history_lines = array.new_line()
var int[] quartile_line_owner_ids = array.new_int()
var box[] quartile_history_fills = array.new_box()
var int[] quartile_fill_owner_ids = array.new_int()
delete_quartiles_for_owner(int owner_id) =>
    if owner_id != 0
        if array.size(quartile_history_lines) > 0
            for qi = array.size(quartile_history_lines) - 1 to 0
                if array.get(quartile_line_owner_ids, qi) == owner_id
                    line.delete(array.get(quartile_history_lines, qi))
                    array.remove(quartile_history_lines, qi)
                    array.remove(quartile_line_owner_ids, qi)
        if array.size(quartile_history_fills) > 0
            for qi = array.size(quartile_history_fills) - 1 to 0
                if array.get(quartile_fill_owner_ids, qi) == owner_id
                    box.delete(array.get(quartile_history_fills, qi))
                    array.remove(quartile_history_fills, qi)
                    array.remove(quartile_fill_owner_ids, qi)
trim_quartile_history() =>
    int keep_lines = math.max(8, (bull_history + bear_history) * 4)
    int keep_fills = math.max(4, (bull_history + bear_history) * 2)
    while array.size(quartile_history_lines) > keep_lines
        line old_q_line = array.shift(quartile_history_lines)
        array.shift(quartile_line_owner_ids)
        line.delete(old_q_line)
    while array.size(quartile_history_fills) > keep_fills
        box old_q_fill = array.shift(quartile_history_fills)
        array.shift(quartile_fill_owner_ids)
        box.delete(old_q_fill)

// Only the latest xC2/xC2+PSP is retained across both directions.
clear_all_ltf_xc2() =>
    while array.size(bear_xc2_history) > 0
        label.delete(array.pop(bear_xc2_history))
    array.clear(bear_xc2_times)
    while array.size(bull_xc2_history) > 0
        label.delete(array.pop(bull_xc2_history))
    array.clear(bull_xc2_times)

delete_ltf_xc2_at_time(int target_time) =>
    if array.size(bear_xc2_times) > 0
        for xi = array.size(bear_xc2_times) - 1 to 0
            if array.get(bear_xc2_times, xi) == target_time
                label.delete(array.get(bear_xc2_history, xi))
                array.remove(bear_xc2_history, xi)
                array.remove(bear_xc2_times, xi)
    if array.size(bull_xc2_times) > 0
        for xi = array.size(bull_xc2_times) - 1 to 0
            if array.get(bull_xc2_times, xi) == target_time
                label.delete(array.get(bull_xc2_history, xi))
                array.remove(bull_xc2_history, xi)
                array.remove(bull_xc2_times, xi)

store_xc2_label(label lb, label[] history, int[] time_history, int invalidated_time, int max_count, bool failed_c2_had_psp) =>
    // A newly invalidated confirmed C2 becomes the only visible xC2-family label.
    clear_all_ltf_xc2()
    delete_c1_psp_chart_label(invalidated_time)
    int role_idx = get_htf_mark_index(invalidated_time)
    bool blocked_by_c3_c4 = role_idx >= 0 and (array.get(htf_marks, role_idx).c3 or array.get(htf_marks, role_idx).c4)
    if not na(lb)
        if blocked_by_c3_c4
            label.delete(lb)
        else
            label.set_text(lb, failed_c2_had_psp ? "xC2+PSP" : "xC2")
            label.set_textcolor(lb, color.red)
            array.push(history, lb)
            array.push(time_history, invalidated_time)
            while array.size(history) > 1
                label old_lb = array.shift(history)
                array.shift(time_history)
                label.delete(old_lb)

upgrade_xc2_to_psp(int c1_time) =>
    int role_idx = get_htf_mark_index(c1_time)
    bool blocked_by_c3_c4 = role_idx >= 0 and (array.get(htf_marks, role_idx).c3 or array.get(htf_marks, role_idx).c4)
    if blocked_by_c3_c4
        delete_ltf_xc2_at_time(c1_time)
    if not blocked_by_c3_c4 and array.size(bear_xc2_times) > 0
        for xi = 0 to array.size(bear_xc2_times) - 1
            if array.get(bear_xc2_times, xi) == c1_time
                label.set_text(array.get(bear_xc2_history, xi), "xC2+PSP")
    if not blocked_by_c3_c4 and array.size(bull_xc2_times) > 0
        for xi = 0 to array.size(bull_xc2_times) - 1
            if array.get(bull_xc2_times, xi) == c1_time
                label.set_text(array.get(bull_xc2_history, xi), "xC2+PSP")

